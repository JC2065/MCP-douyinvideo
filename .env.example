# 视频服务（scripts/video-server.py）环境变量示例。复制为 .env 后按需填写；.env 已被 .gitignore 忽略。
# 不填的项会使用代码中的默认值或关闭相应功能。

# --- 运行与存储 ---
YOUAI_VIDEO_HOST=127.0.0.1
YOUAI_VIDEO_PORT=8765
YOUAI_ASSET_ROOT=./.data/assets
YOUAI_TOOL_ASSET_ROOT=./.data/tools
YOUAI_RENDER_ROOT=./.data/render
YOUAI_VIDEO_FONT=            # 中文字体文件路径，用于 AI 视频生成的文字画面
YOUAI_BOARD_FONT=            # 中文字体文件路径，用于套版成片/裂变的字幕叠加（不填会尝试系统 Noto CJK）
YOUAI_PUBLIC_ASSET_BASE_URL= # 对外访问素材的 HTTPS 基础地址

# --- 微信登录（不填则本地调试不启用登录）---
YOUAI_WECHAT_CONFIG=         # 指向包含 AppID/AppSecret 的 JSON 文件路径，切勿提交该文件

# --- 抖音解析（自建 Douyin_TikTok_Download_API）---
YOUAI_REFERENCE_PARSER_URL=http://127.0.0.1:8000
YOUAI_REFERENCE_PARSER_KEY=
YOUAI_REFERENCE_PARSER_INTERNAL_HTTP_HOSTS=

# --- 远程 MCP（配置文件放在 $YOUAI_ASSET_ROOT/mcp/config.json，见 docs/mcp-remote.md）---
YOUAI_MCP_UPSTREAM=http://127.0.0.1:8000/mcp/
YOUAI_MCP_PUBLIC_BASE=https://your-domain.example/youai

# --- 模型与生成（可选）---
YOUAI_QIANWEN_API_KEY=
YOUAI_QIANWEN_BASE_URL=
YOUAI_QIANWEN_MODEL=
YOUAI_IMAGE_API_KEY=
YOUAI_IMAGE_BASE_URL=
YOUAI_IMAGE_MODEL=
YOUAI_WHISPER_MODEL=

# --- 飞书长期资产台账（可选）---
YOUAI_FEISHU_CONFIG=
YOUAI_FEISHU_STATE=
