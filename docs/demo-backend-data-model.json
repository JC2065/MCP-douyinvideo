{
  "version": 1,
  "baseline": "demo-v1.0",
  "ownerFeatures": ["CORE-01", "CORE-02", "INS-01", "CRT-01", "LEARN-02", "MY-01", "MY-02"],
  "conventions": {
    "ids": "UUIDv7 generated by the client for offline-capable user resources",
    "timestamps": "UTC timestamptz; clients only format for display",
    "userRecordColumns": ["id", "user_id", "version", "created_at", "updated_at", "deleted_at"],
    "concurrency": "expected version required for update and delete",
    "deletion": "soft delete first; deleted rows remain in the sync feed",
    "secrets": "never stored in JSON settings, content, logs, or sync changes"
  },
  "tables": [
    {"name":"users","phase":"A","scope":"account","purpose":"Unified account and display profile","fields":["id uuid pk","status text","display_name varchar(60)","created_at timestamptz","updated_at timestamptz"]},
    {"name":"user_identities","phase":"A","scope":"account","purpose":"Verified WeChat, phone, email, or OIDC identity","fields":["id uuid pk","user_id uuid fk","provider text","subject text","union_subject text nullable","created_at timestamptz","last_used_at timestamptz"],"constraints":["unique(provider, subject)"]},
    {"name":"sessions","phase":"A","scope":"account","purpose":"Revocable device refresh sessions","fields":["id uuid pk","user_id uuid fk","device_id varchar(100)","client_type text","refresh_token_hash text","expires_at timestamptz","revoked_at timestamptz nullable","last_seen_at timestamptz"]},
    {"name":"ideas","phase":"A","scope":"user","purpose":"User ideas and review ideas that can start a project","fields":["common user columns","text varchar(4000)","tags text[]","source_type text","source_ref text nullable","source_snapshot jsonb","target_project_id uuid nullable","occurred_at timestamptz"],"constraints":["text is not blank","source_type in manual, hotspot, learning_case, review"]},
    {"name":"projects","phase":"B","scope":"user","purpose":"Editable creation container and current draft","fields":["common user columns","title varchar(200)","tool_type text","status text","draft_content text","source_type text nullable","source_ref text nullable","source_snapshot jsonb","learning_case_id varchar(80) nullable","analysis_preset varchar(40) nullable","command_template jsonb nullable","latest_version_no integer"],"constraints":["status in draft, completed","latest_version_no >= 0"]},
    {"name":"project_versions","phase":"B","scope":"user","purpose":"Immutable completed or user-created project snapshots","fields":["common user columns","project_id uuid fk","version_no integer","content text","source_snapshot jsonb","learning_case_id varchar(80) nullable","analysis_preset varchar(40) nullable","created_by_session_id uuid nullable"],"constraints":["unique(project_id, version_no)","rows are append-only"]},
    {"name":"learning_cases","phase":"C","scope":"public","purpose":"Versioned case facts, evidence boundaries, methods, and media references","fields":["id varchar(80) pk","content_version integer","title varchar(200)","category text","facts jsonb","analysis jsonb","practice jsonb","media_asset_id uuid nullable","published_at timestamptz nullable"]},
    {"name":"learning_records","phase":"C","scope":"user","purpose":"Per-user favorite, note, and progress for a learning case","fields":["common user columns","case_id varchar(80)","favorited boolean","favorited_at timestamptz nullable","note varchar(4000)","progress jsonb","last_viewed_at timestamptz nullable"],"constraints":["unique(user_id, case_id) where deleted_at is null"]},
    {"name":"creator_profiles","phase":"C","scope":"user","purpose":"Named creation defaults currently stored in creator preferences","fields":["common user columns","name varchar(20)","domain text","audience varchar(100)","goal text","form text","mood text","duration text","platform text","keywords text[]","assistant_mode text","memory varchar(500)","use_defaults boolean","weekly_goal smallint","default_view text","is_active boolean"]},
    {"name":"user_settings","phase":"C","scope":"user","purpose":"Versioned non-secret preferences by namespace","fields":["common user columns","namespace varchar(60)","value jsonb"],"constraints":["unique(user_id, namespace) where deleted_at is null","value cannot contain credentials"]},
    {"name":"assets","phase":"D","scope":"user","purpose":"Private uploaded files and generated outputs","fields":["common user columns","project_id uuid nullable","kind text","object_key text","mime_type text","size_bytes bigint","sha256 char(64)","status text","metadata jsonb"]},
    {"name":"tool_runs","phase":"D","scope":"user","purpose":"Recoverable AI or media-tool execution","fields":["common user columns","project_id uuid nullable","tool_id varchar(60)","status text","input jsonb","result jsonb","error_code text nullable","attempt integer","configuration_version integer"]},
    {"name":"credential_refs","phase":"D","scope":"user","purpose":"Encrypted personal provider credentials referenced by configuration","fields":["common user columns","provider text","label varchar(80)","encrypted_secret bytea","key_version integer","masked_hint varchar(20)"]},
    {"name":"change_log","phase":"A","scope":"sync","purpose":"Monotonic per-user change feed without content copies","fields":["cursor bigserial pk","user_id uuid","entity_type text","entity_id uuid","entity_version integer","operation text","changed_at timestamptz"]},
    {"name":"idempotency_keys","phase":"A","scope":"sync","purpose":"Deduplicate retried writes","fields":["user_id uuid","resource text","action text","key varchar(120)","request_hash char(64)","response_code integer","response_body jsonb","expires_at timestamptz"],"constraints":["unique(user_id, resource, action, key)"]}
  ],
  "localStorage": [
    {"key":"youai-demo-v1","strategy":"split","mappings":{"name":"users.display_name","ideas":"ideas","works":"projects + project_versions","favorites + favoriteAt":"learning_records","role + tasks + earnings":"discard_deferred_business"}},
    {"key":"youai-creator-preferences-v1","strategy":"migrate","mappings":{"profiles":"creator_profiles","active":"creator_profiles.is_active"}},
    {"key":"youai-analysis-preferences-v1","strategy":"migrate","mappings":{"all":"user_settings.analysis_preferences"}},
    {"key":"youai-ai-config-v1","strategy":"split_with_consent","mappings":{"non-secret preferences":"user_settings.model_preferences","keys + custom keys":"require_reentry_to_credential_refs"}},
    {"key":"youai-tool-interfaces-v1","strategy":"split_with_consent","mappings":{"non-secret endpoints":"user_settings.tool_preferences","tokens":"require_reentry_to_credential_refs"}},
    {"key":"youai-video-history","strategy":"hold_local_until_phase_d","mappings":{"all":"tool_runs + assets"}},
    {"key":"youai-nav-ball","strategy":"local_only","mappings":{"all":"device presentation preference"}}
  ],
  "firstMigration": ["users", "user_identities", "sessions", "ideas", "change_log", "idempotency_keys"],
  "deferredDemoFields": ["role", "tasks", "budget", "earnings", "merchant", "orders", "payments"]
}
