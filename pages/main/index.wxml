<app-navigation class="app-navigation" title="有AI" prefixes="{{navPrefixes}}" root="{{true}}" internal="{{!!view}}" bind:back="close"/>
<view class="shell {{!view&&tab!=='我的'?'compact-home':''}}">
 <view wx:if="{{tab!=='我的'||view}}" class="brand"><text>有AI<text class="dot">●</text></text><text class="edition">创作超简单，作品超有价值！</text></view>
 <view wx:if="{{!view&&tab==='任务'}}" class="home-summary"><text>{{state.role==='商家'?'发布需求，跟进每一次创作交付。':'发现好任务，让创作遇见真实需求。'}}</text></view>
 <block wx:if="{{!view}}">
  <block wx:if="{{tab==='灵感'}}">
   <view class="card capture inspiration-capture"><view class="capture-head"><view class="section home-section-title">我想记</view><text class="capture-box-link" bindtap="openIdeaBox">碎片箱 {{ideaCount||0}} ›</text></view><view class="capture-field {{recording?'is-recording':''}}"><textarea placeholder="此刻，你想到了什么？粘链接、截图、说话都能记" value="{{input}}" data-field="input" bindinput="field" maxlength="1000"/><view wx:if="{{recording}}" class="capture-listening">正在听…松开记下</view><view class="row capture-actions"><view class="capture-icon {{recording?'is-on':''}}" bindtouchstart="voiceStart" bindtouchend="voiceEnd" bindtouchcancel="voiceEnd" aria-label="按住说话"><image src="/assets/icons/mic-selected.png" mode="aspectFit"/></view><view class="capture-icon" bindtap="pickImage" aria-label="截图或图片"><image src="/assets/icons/image-selected.png" mode="aspectFit"/></view><text class="capture-saving">{{ideaSaving?ideaSavingText:''}}</text><button class="capture-save {{input?'is-ready':''}}" bindtap="idea" disabled="{{ideaSaving}}">记下来</button></view></view></view>
   <view class="topic-chat">
    <view class="topic-heading"><view class="topic-title">和ta聊</view><view class="topic-heading-actions"><text class="topic-memory-link" bindtap="openTopicMemory">TA 的了解 ›</text><button class="topic-clear" bindtap="clearTopicChat" disabled="{{topicBusy}}">清空</button></view></view>
    <text class="topic-status">{{topicStatus}}</text>
    <scroll-view class="topic-thread" scroll-y enhanced show-scrollbar="{{false}}" scroll-into-view="{{topicScrollTarget}}">
     <view class="topic-welcome" wx:if="{{!topicMessages.length&&!topicBusy}}"><text>登录后，TA 会翻出你记过的碎片，结合最近热点给你出选题。比如：</text><view class="topic-card topic-sample"><view class="topic-source">源自你的碎片：租房遇到奇葩房东</view><view class="strong">我的奇葩房东合集</view><text>第一视角口播 + 聊天截图，今天“租房避坑”话题正在上升。</text></view></view>
     <view id="topic-message-{{index}}" wx:for="{{topicMessages}}" wx:key="index" class="topic-message {{item.role==='user'?'is-user':'is-ai'}}"><text class="topic-speaker">{{item.role==='user'?'你':'TA'}}</text><text class="topic-text" user-select>{{item.text}}</text><view class="topic-card" wx:for="{{item.topics}}" wx:for-item="topic" wx:key="title"><view wx:if="{{topic.fragmentText}}" class="topic-source">源自你的碎片：{{topic.fragmentText}}</view><view class="strong">{{topic.title}}</view><text>{{topic.angle}}</text><view class="topic-actions"><button data-title="{{topic.title}}" data-angle="{{topic.angle}}" data-fragment="{{topic.fragmentId}}" bindtap="topicCreate">用这个主题创作 ›</button><view class="topic-feedback"><text class="topic-fb {{topic.feedback==='up'?'on':''}}" data-msg="{{index}}" data-title="{{topic.title}}" data-angle="{{topic.angle}}" data-kind="up" bindtap="topicFeedback" aria-label="喜欢这个方向">👍 喜欢</text><text class="topic-fb {{topic.feedback==='down'?'on':''}}" data-msg="{{index}}" data-title="{{topic.title}}" data-angle="{{topic.angle}}" data-kind="down" bindtap="topicFeedback" aria-label="不想要这类方向">不想要</text></view></view></view></view>
     <view class="topic-thinking" wx:if="{{topicBusy}}">正在整理思路…</view>
    </scroll-view>
    <view class="topic-error" wx:if="{{topicError}}"><text>{{topicError}}</text><button bindtap="topicRetry" disabled="{{topicBusy}}">重试</button></view>
    <text wx:if="{{topicMessages.length}}" class="topic-scroll-hint">上下滑动对话，查看完整回复</text>
    <view class="topic-composer {{topicExpanded?'is-expanded':''}}"><textarea class="topic-input" style="height:{{topicExpanded?320:topicLineCount>1?104:64}}rpx" value="{{topicInput}}" bindinput="topicField" bindlinechange="topicLines" bindconfirm="topicSend" confirm-type="send" maxlength="1000" show-confirm-bar="{{false}}" disable-default-padding placeholder="{{topicTranscribing?'正在把语音转成文字…':'接着聊聊你的想法…'}}"/><text wx:if="{{topicLineCount>2||topicExpanded}}" class="topic-expand" bindtap="toggleTopicExpand">{{topicExpanded?'收起':'展开'}}</text><view class="topic-voice {{topicRecording?'is-recording':''}}" bindtouchstart="topicVoiceStart" bindtouchend="topicVoiceEnd" bindtouchcancel="topicVoiceEnd" aria-label="按住说话">{{topicRecording?'松开':'语音'}}</view><button class="topic-send" bindtap="topicSend" disabled="{{topicBusy||topicTranscribing}}">{{topicBusy?'…':accountProfile&&accountProfile.phoneBound?'发送':'登录'}}</button></view>
    <view class="topic-footer"><text>仅使用当前账号的云端创作与选题对话记录</text></view>
   </view>
   <view class="inspiration-hotspots">
    <view class="inspiration-section-head"><text class="hotspot-title">看热点</text><button class="hotspot-expand" bindtap="toggleTopicRankings" aria-expanded="{{showTopicRankings}}">{{showTopicRankings?'收起榜单':'展开榜单'}} {{showTopicRankings?'−':'+'}}</button></view>
   <block wx:if="{{showTopicRankings}}">
   <view class="hotspot-sticky-space {{hotspotPinned?'is-pinned':''}}"><view class="hotspot-sticky {{hotspotPinned?'is-fixed':''}}" style="top:{{navigationOffset}}px"><view class="hotspot-topline"><view class="hotspot-mode-switch"><button class="{{hotspotMode==='chat'?'primary':'secondary'}}" data-mode="chat" bindtap="discoverHotspots">搜热点</button><button class="hotspot-ai" bindtap="summarizeHotspots" loading="{{hotspotSummaryBusy}}" disabled="{{hotspotSummaryBusy}}">AI帮我总结最近热点</button></view></view><view class="hotspot-filter-row"><scroll-view class="inline-platforms" scroll-x enhanced show-scrollbar="{{false}}"><view class="inline-platform-track"><text class="watched-keyword {{watchKeyword===item?'active':''}}" wx:for="{{watchKeywords}}" wx:key="*this" data-query="{{item}}" bindtap="selectHotspotWatch">★ {{item}}</text><text class="{{!watchKeyword&&hotspotPlatform===item?'active':''}}" wx:for="{{hotspotPlatforms}}" wx:key="*this" data-platform="{{item}}" bindtap="hotspotPlatform">{{item}}</text></view></scroll-view><text class="hotspot-result-count">{{hotspotVisible.length}} 条 · {{watchKeyword||hotspotPlatform}}</text></view></view></view>
   <view class="watch-panel" wx:if="{{watchKeyword}}"><view class="row"><text class="strong">{{watchKeyword}} · 排名监测</text><button class="watch-remove" bindtap="removeHotspotWatch">取消关注</button></view><text class="watch-notice">{{watchNotice||'关注后将跟踪已采集榜位的变化'}}</text><view class="watch-grid"><view wx:for="{{watchObservations}}" wx:key="platform" class="watch-observation"><view>{{item.platform}}</view><text>{{item.status==='ranked'?'第'+item.rank+'位':item.statusText}}</text><text wx:if="{{item.status==='ranked'}}">{{item.title}}</text><text wx:if="{{item.status==='ranked'}}">{{item.changeText}}</text><text class="watch-history">{{item.trailText}}</text></view></view></view>
   <view class="watch-error" wx:if="{{watchError}}"><text>{{watchError}}</text><button bindtap="retryHotspotWatch">重试同步</button></view>
   <view class="hotspot-summary" wx:if="{{hotspotSummary||hotspotSummaryError}}"><view class="strong">最近热点总结</view><text class="inline-error" wx:if="{{hotspotSummaryError}}">{{hotspotSummaryError}}</text><text wx:else class="summary-copy">{{hotspotSummary}}</text><text class="muted" wx:for="{{hotspotSummarySources}}" wx:key="id">{{item.platform}} · {{item.title}}</text></view>
   <view wx:if="{{hotspotMode==='chat'}}" class="inline-hotspot-chat"><view class="row"><text class="strong">搜索你关心的热点</text><text class="inline-reset" bindtap="hotspotReset">新话题</text></view><view class="inline-search"><input value="{{hotspotQuery}}" bindinput="hotspotInput" bindconfirm="hotspotSend" maxlength="100" confirm-type="search" placeholder="例如：口红、咖啡或周末旅行"/><button class="primary" bindtap="hotspotSend">查找</button></view><view class="inline-suggestions" wx:if="{{!hotspotMessages.length}}"><text wx:for="{{hotspotSuggestions}}" wx:key="*this" data-query="{{item}}" bindtap="hotspotSuggest">{{item}}</text></view><view wx:if="{{hotspotMessages.length}}" class="inline-reply"><text>你：{{hotspotMessages[hotspotMessages.length-1].query}}</text><text>{{hotspotReply}}</text></view><text wx:if="{{hotspotError}}" class="inline-error">{{hotspotError}}</text></view>
   <view class="keyword-search-results" wx:if="{{watchKeyword&&(hotspotSearching||hotspotSearchItems.length||hotspotSearchNotice)}}"><view class="strong">{{hotspotSearching?'正在搜索…':'相关内容'}}</view><text class="watch-notice">{{hotspotSearchNotice}}</text><view class="keyword-search-item" wx:for="{{hotspotSearchItems}}" wx:key="id"><view class="strong">{{item.title}}</view><text>{{item.excerpt}}</text><text class="watch-notice">{{item.source}} · {{item.publishedAt||'未提供发布时间'}} · 非榜位记录</text><button data-url="{{item.url}}" bindtap="copyHotspotSource">复制来源链接</button></view></view>
   <view class="hotspot-trend-tabs"><text class="{{hotspotMode==='rising'?'active':''}}" data-mode="rising" bindtap="hotspotTrendMode">正在升温</text><text class="{{hotspotMode==='new'?'active':''}}" data-mode="new" bindtap="hotspotTrendMode">新上榜</text><text class="{{hotspotMode==='rank'?'active':''}}" data-mode="rank" bindtap="hotspotTrendMode">完整榜</text></view>
   <view class="muted">{{hotspotStatus}}</view>
   <view class="inline-hotspot-list"><view class="inline-hotspot-empty" wx:if="{{!hotspotVisible.length}}">{{watchKeyword?'本轮暂无符合所选榜单的关键词记录，相关内容见上方。':hotspotMode==='rising'?'暂未发现有效上升记录。每10分钟同步，也可切换完整榜。':hotspotMode==='new'?'本轮没有新入采集榜的话题。':'没有匹配内容，请切换平台或关键词。'}}</view><view class="inline-trend" wx:for="{{hotspotVisible}}" wx:key="id"><view class="inline-trend-main"><view class="grow"><view class="inline-trend-title">{{item.title}}</view><view class="inline-trend-meta"><text>{{item.platform}}</text><text>{{item.evidence}}</text></view></view><text class="trend-change {{item.trend==='new'?'is-new':''}}">{{item.trendLabel}}</text></view><view class="inline-trend-angle">{{item.comparisonLabel}}</view><view class="inline-trend-actions"><button data-id="{{item.id}}" bindtap="hotspotDetails">查看话题</button><button data-id="{{item.id}}" bindtap="createDiscoveredHotspot">用话题创作</button></view></view></view><view class="hotspot-more" bindtap="hotspotMore">查看全部话题变化</view>
   </block>
   </view>

  </block>
  <block wx:if="{{tab==='创作'}}">
   <view class="entry-row">
    <button class="entry entry-primary" hover-class="entry-pressed" data-source="douyin" bindtap="videoStudio"><view class="hero-top"><view class="entry-icon"><image src="/assets/icons/create-selected.png" mode="aspectFit"/></view><text class="hero-kicker">粘贴链接就能开始</text></view><text class="entry-title">爆款拆解复刻</text><text class="hero-sub">拆出它为什么火 · 照着拍出你的版本</text><view class="hero-go">开始拆解 ›</view></button>
    <view class="entry-secondary">
     <button class="entry entry-compact" hover-class="entry-pressed" data-source="idea" bindtap="videoStudio"><image src="/assets/icons/inspiration-selected.png" mode="aspectFit"/><view><text class="entry-title">一句话出作品</text></view><text class="entry-arrow">›</text></button>
     <button class="entry entry-compact" hover-class="entry-pressed" data-source="command" bindtap="videoStudio"><image src="/assets/icons/sparkle-selected.png" mode="aspectFit"/><view><text class="entry-title">爆款口令</text></view><text class="entry-arrow">›</text></button>
    </view>
   </view>
   <view class="section">创作工具</view>
   <view class="tool-grid"><view class="card tool-item" wx:for="{{creationTools}}" wx:key="id" data-name="{{item.name}}" data-tool="{{item.icon}}" bindtap="toolEntry"><image class="tool-glyph" src="/assets/icons/{{item.icon}}-selected.png" mode="aspectFit" aria-hidden="true"/><text class="tool-name">{{item.name}}</text></view></view>
   <view class="section feedback-head"><text>数据监控</text><text class="feedback-all" bindtap="openFeedback">数据面板 ›</text></view><view class="feedback-tabs"><text wx:for="{{feedbackGroups}}" wx:key="id" class="feedback-tab {{feedbackTab===item.id?'active':''}}" data-tab="{{item.id}}" bindtap="feedbackTabPick">{{item.label}}<text wx:if="{{item.count}}" class="feedback-count"> {{item.count}}</text></text></view><view class="card feedback-add"><view class="feedback-add-row"><input class="feedback-input" value="{{monitorLink}}" placeholder="{{feedbackTab==='own'?'粘贴你自己发布的抖音作品链接':'粘贴对标账号的抖音作品链接'}}" bindinput="monitorInput" bindconfirm="addMonitor"/><button class="feedback-go" bindtap="addMonitor" loading="{{monitorBusy}}" disabled="{{monitorBusy||!monitorLink}}">监控</button></view><view class="feedback-tip">{{feedbackTab==='own'?'不是用有AI做的也可以，还能补传创作者后台截图参与复盘。':'跟踪对标账号的作品涨势，每天自动记一次，连续 14 天。'}}</view></view><view wx:if="{{feedbackError}}" class="muted" bindtap="refreshFeedback">{{feedbackError}} · 点击重试</view><view wx:for="{{feedbackShown}}" wx:key="id" class="card feedback-row" data-id="{{item.id}}" bindtap="openFeedbackWork"><view class="row"><text class="strong grow feedback-title">{{item.title}}</text><text class="badge feedback-badge {{item.kind}}">{{item.badge}}</text></view><view wx:if="{{item.stats.length}}" class="feedback-stats"><view wx:for="{{item.stats}}" wx:for-item="s" wx:key="key" class="feedback-stat"><text class="feedback-num">{{s.value}}</text><text class="feedback-label">{{s.label}}</text><text wx:if="{{s.delta}}" class="feedback-delta">{{s.delta}}</text></view></view><view class="muted">{{item.state}}</view></view><view wx:if="{{!feedbackShown.length&&!feedbackError}}" class="feedback-empty">{{feedbackTab==='own'?'还没有你的作品数据。拆解后点「生成发布包并回传数据」，或在上面贴你发布的作品链接。':'还没有对标作品。贴一条对标账号的作品链接，开始跟踪它的数据。'}}</view><view class="section creative-head" bindtap="toggleCreative"><text>我的创作</text><text class="feedback-all">{{creativeOpen?'收起 ▴':(creativeWorks.length?creativeWorks.length+' 份 · ':'')+'展开 ▾'}}</text></view><block wx:if="{{creativeOpen}}"><view wx:if="{{creativeError}}" class="muted" bindtap="refreshCreativeAssets">{{creativeError}} · 点击重试</view><view class="empty" wx:if="{{!creativeWorks.length}}">你的第一份作品，从上方工具开始。粘贴一条抖音链接做爆款拆解，也会记录在这里。</view><view class="card creative-work" wx:for="{{creativeWorks}}" wx:key="key"><view class="row"><text class="strong grow">{{item.title}}</text><text class="badge">{{item.label}}</text></view><view wx:if="{{item.preview}}" class="excerpt">{{item.preview}}</view><view class="muted">{{item.kind==='draft'?item.status:item.stage||'已保存'}}</view><view wx:if="{{item.kind==='draft'}}" class="link" data-work="{{item.id}}" bindtap="copyCommand">复制这份方案为创作口令</view><button class="secondary" data-key="{{item.key}}" bindtap="openCreativeWork">{{item.kind==='draft'?'继续编辑':item.kind==='analysis'?'打开拆解':item.kind==='replica'?'查看复刻':'查看作品'}}</button><button wx:if="{{item.kind==='draft'&&item.status==='已完成'}}" class="secondary" data-id="{{item.id}}" bindtap="reviewWork">复盘 → 新灵感</button></view></block>
  </block>
  <block wx:if="{{tab==='拆学'}}">
   <view class="study-workbench">
    <view class="study-workbench-head"><view><view class="study-workbench-title">拆解工作台</view><text class="study-workbench-sub">拆出方法，学以致用</text></view><button class="study-records" bindtap="analysisRecords">拆解记录 ›</button></view>
    <view class="study-workbench-actions"><button class="study-start" data-source="douyin" bindtap="videoStudio"><text>拆一条视频</text><text class="study-action-note">从参考视频开始 ›</text></button><button class="study-templates" bindtap="settings"><text>我的拆解模板</text><text class="study-action-note">目标组合 · DIY ›</text></button></view>
   </view>
   <view class="study-shelf-switch"><button class="{{studyShelf==='works'?'active':''}}" data-shelf="works" bindtap="studyShelf">优秀作品</button><button class="{{studyShelf==='projects'?'active':''}}" data-shelf="projects" bindtap="studyShelf">优秀项目</button></view><block wx:if="{{studyShelf==='works'}}"><view class="learning-filters"><scroll-view class="category-scroll" scroll-x enhanced show-scrollbar="{{false}}"><view class="category-track"><text wx:for="{{['全部','人物讲解','情绪种草','优惠转化','演示证据','资讯清单','人物展示','角色表达']}}" wx:key="*this" class="chip {{filter===item&&!onlyFav?'active':''}}" data-filter="{{item}}" bindtap="filter">{{item}}</text></view></scroll-view><text class="chip favorite-filter {{onlyFav?'active':''}}" bindtap="favs">收藏</text></view>
   <block wx:for="{{cases}}" wx:key="id"><view wx:if="{{(filter==='全部'||filter===item.tag)&&(!onlyFav||item.favorited)}}" class="card case case-list-item learning-case" data-id="{{item.id}}" bindtap="caseDetail"><view class="cover {{item.color}}"><image wx:if="{{item.poster}}" class="case87-thumb" src="{{item.poster}}" mode="aspectFill"/><text class="cover-small">有AI · 精选案例</text><text class="cover-title">{{item.cover}}</text><text class="cover-bottom">SHORT FILM STUDY ↗</text></view><view class="case-body"><view class="strong case-title">{{item.title}}</view><view class="case-meta"><text class="badge">{{item.tag}}</text><text wx:if="{{item.duration}}" class="muted">{{item.duration}} 秒</text></view></view></view></block><view class="empty" wx:if="{{onlyFav&&!state.favorites.length}}">还没有收藏，打开一个案例试试。</view></block><block wx:else><view class="project-showcase"><view class="project-card"><text class="project-tag">创作者成长项目</text><view class="strong">短视频创作加速计划</view><text>从选题、拆解到作品发布，完成一轮创作实践。</text><view class="project-meta"><text>项目状态 · 即将开放</text><text>适合 · 个人创作者</text></view></view><view class="project-card"><text class="project-tag">品牌共创项目</text><view class="strong">真实需求共创计划</view><text>与合作方围绕真实需求共同创作并沉淀可复用案例。</text><view class="project-meta"><text>项目状态 · 筹备中</text><text>适合 · 创作者与商家</text></view></view></view></block>
  </block>
  <block wx:if="{{tab==='任务'}}">
   <button wx:if="{{state.role==='商家'}}" class="primary" bindtap="newTask"><image class="action-icon" src="/assets/icons/plus-white.png" mode="aspectFit" aria-hidden="true"/>发布短视频任务</button><view class="section">{{state.role==='商家'?'任务管理':'任务大厅'}} <text class="muted">{{state.role}}视角</text></view>
   <view class="card task-opening"><button class="primary" bindtap="expectTaskOpening">期待开放 +1</button></view>
  </block>
  <block wx:if="{{tab==='我的'}}">
   <view class="account-overview">
    <view class="profile creator-profile"><view class="avatar">{{accountProfile ? accountProfile.avatarText : '有'}}</view><view class="grow"><view class="heading">{{accountProfile ? accountProfile.nickname : state.name}}</view><text class="muted">{{creator.name}} · {{creator.domain}}</text></view><button class="account-edit" data-view="profile" bindtap="open">账号资料</button></view>
   </view>
   <view wx:if="{{accountProfile&&accountProfile.trial}}" class="trial-card"><view class="trial-title">体验版账号 · {{accountProfile.trialPhone}}</view><text>数据照常上传，中台标注为“体验版”。</text><view class="trial-actions"><button bindtap="trialLogin">再生成一个</button><button bindtap="exitTrial">退出体验账号</button></view></view>
   <view wx:elif="{{canTrial&&accountProfile&&accountProfile.phoneBound}}" class="trial-card trial-entry"><view class="trial-title">体验版全量验证</view><text>可生成独立体验账号（虚构100号段手机号），数据照常上传并在中台标注为“体验版”。</text><view class="trial-actions"><button bindtap="trialLogin">生成体验账号</button></view></view>
   <view wx:if="{{!accountProfile||!accountProfile.phoneBound}}" class="guest-login-card"><view class="guest-login-title">先体验，再决定登录</view><text>灵感、案例和创作工具可以直接浏览。登录后可同步创作资产并使用账号专属功能。</text><button class="primary" bindtap="openLogin">手机号快速验证登录</button></view>
   <view class="account-shortcuts">
    <button bindtap="videoAssets"><image src="/assets/icons/cover-selected.png"/><text>创作资产</text></button>
    <button bindtap="toggleAccountMore" aria-expanded="{{accountMore}}"><image src="/assets/icons/profile-selected.png"/><text>偏好设置</text></button>
    <button bindtap="merchantEntry"><image src="/assets/icons/tasks-selected.png"/><text>{{state.role==='商家'?'切回用户':'切为商家'}}</text></button>
    <button data-tab="任务" bindtap="tab"><image src="/assets/icons/tasks-selected.png"/><text>任务进度</text></button>
   </view>
   <view wx:if="{{accountMore}}" class="account-group account-more">
    <block wx:if="{{accountMore}}">
    <view class="account-row" data-section="direction" bindtap="preferences"><text>创作方向</text><text class="account-chevron">›</text></view>
<view class="account-row" data-section="video" bindtap="preferences"><text>视频偏好</text><text class="account-chevron">›</text></view>
<view class="account-row" data-section="topics" bindtap="preferences"><text>关注热点</text><text class="account-chevron">›</text></view>
<view class="account-row" data-section="agent" bindtap="preferences"><text>AI 助手</text><text class="account-chevron">›</text></view>
    <view class="account-row" data-section="rhythm" bindtap="preferences"><text>创作节奏</text><text class="account-chevron">›</text></view>
    <view class="account-row settings-entry" bindtap="settings"><text>拆解方案</text><text class="account-chevron">›</text></view>

     <view class="account-row" bindtap="aiConfig"><text>模型与技能</text><text class="account-chevron">›</text></view>
     <view class="account-row" bindtap="toolInterfaces"><text>工具接口管理</text><text class="account-value">公共接口 · 个人配置</text><text class="account-chevron">›</text></view>
     <view class="account-row" data-view="about" bindtap="open"><text>关于有AI</text><text class="account-chevron">›</text></view>
     <view class="account-row admin-entry" bindtap="adminConsole"><text>管理中台</text><text class="account-value">管理员登录</text><text class="account-chevron">›</text></view>
     <view class="account-row account-reset" bindtap="reset"><text>重置本机数据</text><text class="account-chevron">›</text></view>
    </block>
   </view>
   <view class="card record-frame">
    <view class="record-header"><text class="record-title">{{recordMode==='favorites'?'已收藏':recordMode==='works'?'已创作':'已记录'}} <text class="muted">{{recordCount}} {{recordMode==='works'?'份':'条'}}</text></text><view class="record-switch"><button class="{{recordMode==='favorites'?'is-active':''}}" data-mode="favorites" bindtap="recordMode">收藏</button><button class="{{recordMode==='works'?'is-active':''}}" data-mode="works" bindtap="recordMode">作品</button><button class="{{recordMode==='list'?'is-active':''}}" data-mode="list" bindtap="recordMode">点子</button><button class="{{recordMode==='calendar'?'is-active':''}}" data-mode="calendar" bindtap="recordMode">日历</button></view></view>
    <view class="record-panel">
     <scroll-view wx:if="{{recordCount||recordMode==='calendar'}}" class="record-scroll" scroll-y enhanced show-scrollbar="{{false}}">
      <block wx:if="{{recordMode==='calendar'}}">
       <view class="idea-calendar"><view class="calendar-toolbar"><button data-delta="-1" bindtap="calendarMove" aria-label="上个月">‹</button><text class="calendar-month">{{calendar.label}}</text><button data-delta="1" bindtap="calendarMove" aria-label="下个月">›</button><text class="calendar-stats">{{calendar.count}} 条 · {{calendar.activeDays}} 天</text><button class="calendar-today" bindtap="calendarToday">今天</button></view>
        <view class="calendar-grid"><text class="calendar-week" wx:for="{{['一','二','三','四','五','六','日']}}" wx:key="*this">{{item}}</text><view wx:for="{{calendar.days}}" wx:key="id" class="calendar-day level-{{item.level}} {{item.key?'day-valid':'day-empty'}} {{item.selected?'day-selected':''}} {{item.today?'day-today':''}}" data-day="{{item.key}}" bindtap="calendarSelect" aria-label="{{item.key?item.key+'，'+item.count+'条记录':''}}"><text>{{item.day}}</text><view wx:if="{{item.today}}" class="today-dot"></view></view></view>
       </view>
       <view class="calendar-date"><view><text class="calendar-date-main">{{calendar.selectedLabel}}</text><text class="calendar-date-count">当天 {{recordCount}} 条</text></view><text class="muted">向下滑动查看</text></view>
       <block wx:if="{{calendar.records.length}}"><view class="feed-group">点子 {{calendar.records.length}}</view><view class="record-item record-idea" wx:for="{{calendar.records}}" wx:key="id"><view class="record-item-head"><view class="record-kind"><image src="/assets/icons/inspiration-selected.png" mode="aspectFit"/><text>灵感记录</text></view><text class="record-meta">点子</text></view><text class="record-copy">{{item.text}}</text><view class="record-item-actions"><button data-id="{{item.id}}" bindtap="videoStudio"><image src="/assets/icons/sparkle-selected.png" mode="aspectFit"/>生成视频</button><button data-id="{{item.id}}" bindtap="inspire"><image src="/assets/icons/create-selected.png" mode="aspectFit"/>开始创作</button></view></view></block>
       <block wx:if="{{dayFeed.works.length}}"><view class="feed-group">作品 {{dayFeed.works.length}}</view><view class="record-item record-work" wx:for="{{dayFeed.works}}" wx:key="id"><view class="record-item-head"><view class="record-kind"><image src="/assets/icons/create-selected.png" mode="aspectFit"/><text>创作方案</text></view><text class="record-status">{{item.status}}</text></view><text class="record-copy">{{item.title}}</text><text class="record-summary">{{item.text}}</text><view class="record-item-actions single"><button data-id="{{item.id}}" bindtap="editor">打开编辑</button></view></view></block>
       <block wx:if="{{dayFeed.assets.length}}"><view class="feed-group">创作资产 {{dayFeed.assets.length}}</view><view class="record-item record-work" wx:for="{{dayFeed.assets}}" wx:key="key"><view class="record-item-head"><view class="record-kind"><image src="/assets/icons/create-selected.png" mode="aspectFit"/><text>{{item.label}}</text></view><text class="record-meta">{{item.kind==='video'?'视频':item.kind==='text'?'文字':item.kind==='image'?'图片':item.kind==='chat'?'交流':'拆解'}}</text></view><text class="record-copy">{{item.title}}</text><text wx:if="{{item.preview}}" class="record-summary">{{item.preview}}</text></view></block>
       <block wx:if="{{dayFeed.favorites.length}}"><view class="feed-group">收藏 {{dayFeed.favorites.length}}</view><view class="record-item record-favorite" wx:for="{{dayFeed.favorites}}" wx:key="id" data-id="{{item.id}}" bindtap="caseDetail"><view class="record-item-head"><view class="record-kind"><image src="/assets/icons/learn-selected.png" mode="aspectFit"/><text>收藏案例</text></view><text class="record-meta">{{item.tag}}</text></view><text class="record-copy">{{item.title}}</text><text class="record-summary">{{item.goal}}</text><view class="record-item-actions single"><button>查看拆解</button></view></view></block>
       <view class="empty record-empty" wx:if="{{!recordCount}}">当天没有记录、作品或收藏，可选择其他日期。</view>
      </block>
      <block wx:elif="{{recordMode==='favorites'}}"><block wx:for="{{cases}}" wx:key="id"><view wx:if="{{item.favorited}}" class="record-item record-favorite"><view class="record-item-head"><view class="record-kind"><image src="/assets/icons/learn-selected.png" mode="aspectFit"/><text>收藏案例</text></view><text class="record-meta">{{item.tag}}</text></view><text class="record-copy">{{item.title}}</text><text class="record-summary">{{item.goal}}</text><view class="record-item-actions single"><button data-id="{{item.id}}" bindtap="caseDetail">查看拆解</button></view></view></block></block>
      <block wx:elif="{{recordMode==='works'}}"><view class="record-item record-work" wx:for="{{state.works}}" wx:key="id"><view class="record-item-head"><view class="record-kind"><image src="/assets/icons/create-selected.png" mode="aspectFit"/><text>创作方案</text></view><text class="record-status">{{item.status}}</text></view><text class="record-copy">{{item.title}}</text><text class="record-summary">{{item.text}}</text><view class="record-version">已保存 {{item.versions.length}} 个版本</view><view class="record-item-actions single"><button data-id="{{item.id}}" bindtap="editor">打开编辑</button></view></view></block>
      <block wx:else><view class="record-item record-idea" wx:for="{{state.ideas}}" wx:key="id"><view class="record-item-head"><view class="record-kind"><image src="/assets/icons/inspiration-selected.png" mode="aspectFit"/><text>灵感记录</text></view><text class="record-meta">点子</text></view><text class="record-copy">{{item.text}}</text><view class="record-item-actions"><button data-id="{{item.id}}" bindtap="videoStudio"><image src="/assets/icons/sparkle-selected.png" mode="aspectFit"/>生成视频</button><button data-id="{{item.id}}" bindtap="inspire"><image src="/assets/icons/create-selected.png" mode="aspectFit"/>开始创作</button></view></view></block>
     </scroll-view>
     <view class="empty record-empty" wx:else>{{recordMode==='favorites'?'还没有收藏，去「拆学」里打开一个案例试试。':recordMode==='works'?'还没有作品，去「创作」开始你的第一份方案。':'先记录一个问题、场景或观察，再把它变成创作。'}}</view>
     <view wx:if="{{recordCount}}" class="record-fade"></view>
    </view>
   </view>


  </block>
 </block>
 <block wx:else>
  <block wx:if="{{view==='command'}}"><view class="heading">用创作口令，一键开始</view><view class="sub">复制的是方法和结构，主题由你来定。</view><textarea class="editor command-input" placeholder="粘贴有AI创作口令……" value="{{commandInput}}" bindinput="commandField" maxlength="100000"/><button class="secondary" bindtap="parseCommand">查看口令思路</button><view class="card" wx:if="{{commandPreview}}"><view class="strong">{{commandPreview.name}}</view><view class="body">{{commandPreview.idea}}</view></view><input class="input" placeholder="填入你的主题，例如：我的早餐店" value="{{commandTheme}}" data-field="commandTheme" bindinput="field" maxlength="100"/><button class="primary" bindtap="useCommand">一键生成创作草稿</button><view class="sub">生成后可编辑、保存并完成方案。目前生成文本草稿，尚不生成视频。</view><view class="section">没有口令？先试一个</view><view class="card" wx:for="{{commandExamples}}" wx:key="id" data-id="{{item.id}}" bindtap="commandExample"><view class="strong">{{item.tag}}方法</view><view class="body">{{item.method}}</view><text class="link">使用示例口令 →</text></view></block>
  <block wx:if="{{view==='editor'}}"><view class="heading">创作工作台</view><view class="sub">确定主题 → 借鉴方法 → 编辑脚本 → 完成方案</view><view class="card"><view wx:if="{{source}}" class="body">来源：{{source.type}} · {{source.text}}</view><view wx:else class="muted">自主创作</view><view wx:if="{{caseTitle}}" class="body">参考案例：{{caseTitle}}</view><button class="secondary" bindtap="learnForDraft">从学习案例中选方法</button></view><view wx:if="{{analysisProfile}}" class="card"><view class="strong">拆解模板：{{analysisProfile.template.name}}</view><text class="muted">{{analysisProfile.goalText}}</text></view><input class="input" maxlength="100" placeholder="给作品一个主题" value="{{title}}" data-field="title" bindinput="field"/><view class="chips"><text wx:for="{{tools}}" wx:key="*this" class="chip {{tool===item?'active':''}}" data-tool="{{item}}" bindtap="tool">{{item}}</text></view><button class="secondary" bindtap="generate"><image class="action-icon" src="/assets/icons/sparkle-selected.png" mode="aspectFit" aria-hidden="true"/>生成{{tool}}示例</button><text class="muted">生成会替换编辑区内容，请先保存需要保留的草稿。</text><textarea class="editor" placeholder="在这里写下脚本、分镜或创作思路……" value="{{draft}}" data-field="draft" bindinput="field" maxlength="10000"/><view class="row actions"><button class="secondary" bindtap="saveWork">保存草稿</button><button class="primary" data-complete="true" bindtap="saveWork">完成创作方案</button></view></block>
  <block wx:if="{{view==='casePicker'}}"><view class="heading">给当前主题选一个方法</view><view class="sub">主题与来源会保留；应用方法前会确认是否替换已有内容。</view><view class="card" wx:for="{{cases}}" wx:key="id" data-id="{{item.id}}" bindtap="caseDetail"><text class="badge">{{item.tag}}</text><view class="strong">{{item.title}}</view><view class="body">{{item.goal}}</view></view></block>
  <block wx:if="{{view==='case'}}"><view class="cover {{selected.color}}"><text class="cover-title">{{selected.cover}}</text></view><view class="heading detail-title">{{selected.title}}</view><view class="card" wx:if="{{selected.url}}"><text class="badge">{{selected.platform}} · 部分核实</text><view class="body">作者：{{selected.author}}</view><view class="body">{{selected.evidence}}</view><text class="muted">以下方法与练习是分析建议，非原片完整还原；未取得实际转化数据。</text><button class="secondary" bindtap="copyVideoSource">复制原视频链接</button></view><text wx:else class="muted">原创教学样例 · 非真实视频拆解 · 无实际转化数据</text><view class="card"><view class="section">01 人群与引流目标</view><view class="body">{{selected.audience}} → {{selected.goal}}</view><view class="section">02 开头钩子</view><text>{{selected.hook}}</text><view class="section">03 内容结构</view><text>{{selected.structure}}</text><view class="section">04 原创练习框架</view><view class="body">{{selected.script}}</view><view class="section">05 可迁移方法</view><text>{{selected.method}}</text><view class="body">练习：{{selected.practice}}</view><view class="section">06 行动引导</view><text>{{selected.cta}}</text><view class="section">07 复盘指标与注意事项</view><view class="body">{{selected.metric}}</view><text>{{selected.pitfall}}</text></view><button class="secondary" data-case="{{selected.id}}" bindtap="copyCommand">复制这个方法为创作口令</button><view class="actions row"><button class="secondary" bindtap="favorite">收藏 / 取消收藏</button><button class="primary" bindtap="applyCase">用这个方法创作</button></view></block>
  <block wx:if="{{view==='review'}}"><view class="heading">复盘，让下一条更好</view><view class="sub">{{selected.title}}</view><view class="card"><view wx:if="{{selected.source}}" class="body">来源：{{selected.source.type}} · {{selected.source.text}}</view><view class="body">参考案例：{{selected.caseTitle||'自主创作'}}</view><text>记录你实际观察到的结果：哪一句吸引了人、行动引导是否清楚、下次改什么。尚未发布也可记录拍摄前自检，不必编造数据。</text></view><textarea class="editor" value="{{review}}" data-field="review" bindinput="field" maxlength="1000" placeholder="实际观察 / 暂未发布；发现的问题；下一次尝试……"/><button class="primary" bindtap="saveReview">保存复盘，并存入我的记录</button></block>
  <block wx:if="{{view==='task'}}"><text class="badge">{{selected.status}}</text><view class="heading detail-title">{{selected.title}}</view><view class="price">¥ {{selected.budget}} </view><view class="card"><view class="strong">创作需求</view><view class="body">{{selected.brief}}</view><text class="muted">截止日期 {{selected.date}}</text></view><view class="card"><view class="strong">合作流程</view><view class="timeline" wx:for="{{selected.history}}" wx:key="index">● {{item}}</view></view><view class="sub">当前：{{state.role}}身份 · 可在“我的”切换身份</view>
   <button wx:if="{{state.role==='个人'&&selected.status==='招募中'}}" class="primary" data-action="apply" bindtap="action">申请接单</button><button wx:if="{{state.role==='商家'&&selected.status==='待选人'}}" class="primary" data-action="select" bindtap="action">选定小有同学，开始合作</button><button wx:if="{{state.role==='个人'&&(selected.status==='制作中'||selected.status==='待修改')}}" class="primary" data-action="{{selected.status==='待修改'?'resubmit':'submit'}}" bindtap="action">选择已完成作品并提交</button><block wx:if="{{state.role==='商家'&&selected.status==='待验收'}}"><textarea class="input" placeholder="需要修改时，请填写具体建议" value="{{feedback}}" data-field="feedback" bindinput="field"/><view class="row actions"><button class="secondary" data-action="revise" bindtap="action">要求修改</button><button class="primary" data-action="accept" bindtap="action">验收通过</button></view></block><view class="card" wx:if="{{selected.status==='已完成'}}">合作完成！验收记录已保存。</view>
  </block>
  <block wx:if="{{view==='publish'}}"><view class="heading">发布创作需求</view><view class="sub">说清目标，让创作者理解你的品牌。</view><input class="input" placeholder="任务标题" data-field="title" value="{{title}}" bindinput="field"/><textarea class="editor" placeholder="品牌背景、视频时长、风格、交付要求……" data-field="draft" value="{{draft}}" bindinput="field"/><input class="input" type="digit" placeholder="预算（元）" data-field="budget" value="{{budget}}" bindinput="field"/><picker mode="date" value="{{date}}" data-field="date" bindchange="field"><view class="input">截止日期：{{date}}</view></picker><button class="primary" bindtap="publish">发布任务</button></block>
  <block wx:if="{{view==='profile'}}"><view class="heading">账号资料</view><view class="card profile-editor"><view class="strong">昵称</view><input value="{{editNickname}}" data-field="editNickname" bindinput="profileField" maxlength="30" placeholder="填写昵称"/><view class="strong">头像</view><picker range="{{avatarOptions}}" value="{{editAvatar}}" bindchange="profileAvatar"><view class="profile-avatar-choice">{{avatarOptions[editAvatar]}} · 点击更换</view></picker><view class="strong">手机号</view><view class="muted">{{accountProfile.phoneMasked}}</view><view class="strong">邮箱</view><input value="{{editEmail}}" data-field="editEmail" bindinput="profileField" maxlength="254" placeholder="填写邮箱"/><view class="muted">邮箱仅保存，暂未验证绑定。</view><view wx:if="{{profileError}}" class="profile-error">{{profileError}}</view><button class="primary" bindtap="saveAccountProfile" loading="{{profileSaving}}" disabled="{{profileSaving}}">保存资料</button></view></block>
  <block wx:if="{{view==='earnings'}}"><view class="heading">订单与收益</view><view class="sub">验收记录，不涉及支付或提现。</view><view class="empty" wx:if="{{!state.earnings.length}}">完成一次任务验收后，记录会出现在这里。</view><view class="card" wx:for="{{state.earnings}}" wx:key="taskId"><view class="strong">{{item.title}}</view><view class="price">¥ {{item.amount}}</view><text class="badge">已验收</text></view></block>
  <block wx:if="{{view==='about'}}"><view class="heading">关于有AI</view><view class="card body">五个入口，连接灵感、创作、学习与合作。所有数据保存在本机。热点、案例和 AI 文本为示例；身份切换用于体验双端流程，不代表真实认证。当前不接入网络、支付、视频上传或作品授权交易。</view></block>
 </block>
</view>
<view class="nav"><view wx:for="{{tabs}}" wx:key="*this" class="nav-item {{tab===item?'selected':''}}" data-tab="{{item}}" bindtap="tab"><image class="nav-icon" src="/assets/icons/{{index===0?'inspiration':index===1?'create':index===2?'learn':index===3?'tasks':'profile'}}-{{tab===item?'selected':'default'}}.png" mode="aspectFit" aria-hidden="true"/><text>{{item}}</text><view class="nav-dot" wx:if="{{tab===item}}"/></view></view>

<view wx:if="{{authVisible}}" class="auth-overlay" catchtouchmove="stopAuthTouch">
 <view class="auth-sheet" role="dialog" aria-modal="true" aria-label="微信登录">
  <view class="auth-handle"/>
  <view class="auth-title">微信登录有AI</view>
  <view class="auth-subtitle">{{authPrompt||'手机号用于账号注册登录与安全验证'}}</view>
  <view class="auth-identity" wx:if="{{profile}}"><text class="auth-avatar">{{profile.avatarText}}</text><text>{{profile.nickname}}</text></view>
  <view class="auth-error" wx:if="{{error}}">{{error}}</view>
  <view class="auth-consent"><view class="auth-consent-head" bindtap="toggleCollect"><text class="auth-consent-title">用户信息采集声明</text><text class="auth-consent-more">{{collectOpen?'收起':'展开全文'}}</text></view><view wx:for="{{collectItems}}" wx:key="index" wx:if="{{collectOpen||index<2}}" class="auth-consent-item">{{index+1}}. {{item}}</view></view>
  <view class="auth-agree" bindtap="toggleAgree"><view class="auth-check {{authAgree?'on':''}}">{{authAgree?'✓':''}}</view><text>我已阅读并同意《用户信息采集声明》和</text><text class="auth-link" catchtap="privacy">《隐私保护指引》</text></view>
  <button wx:if="{{ready&&!authAgree}}" class="auth-button auth-button-off" bindtap="needAgree">手机号快速验证并进入</button>
  <button wx:elif="{{ready}}" class="auth-button" open-type="getPhoneNumber" phone-number-no-quota-toast="{{true}}" bindgetphonenumber="authorize" loading="{{busy}}" disabled="{{busy}}">手机号快速验证并进入</button>
  <button wx:else class="auth-button" bindtap="prepare" loading="{{busy}}" disabled="{{busy}}">{{busy?'正在连接微信…':'重新连接微信'}}</button>
  <view class="auth-note">不登录也可以继续浏览和体验</view>
  <button class="auth-later" bindtap="closeLogin">稍后再说，先逛逛</button>
  <button wx:if="{{canPreview}}" class="auth-preview" bindtap="previewLocally">开发工具：先调试页面</button>
  <button wx:if="{{canTrial}}" class="auth-trial" bindtap="trialLogin" disabled="{{busy}}">体验版：生成体验账号（随机手机号）</button>
  <text class="auth-privacy" bindtap="privacy">隐私保护指引</text>
 </view>
</view>

<view class="interest-toast-layer" aria-live="polite"><view wx:for="{{interestToasts}}" wx:key="id" class="interest-toast">已收到，正在超级加速！</view></view>
