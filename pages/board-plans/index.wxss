.board-plans{padding:24rpx;padding-bottom:80rpx}.tabs{display:flex;gap:24rpx;margin-bottom:16rpx}.tab{font-size:27rpx;color:#718095;padding:8rpx 0}.tab.active{color:#075dcc;font-weight:600;border-bottom:4rpx solid #075dcc}.field{box-sizing:border-box;width:100%;padding:14rpx;margin:10rpx 0;border-radius:12rpx;background:#f3f6fa;font-size:25rpx}.field.small{height:110rpx}textarea.field{height:160rpx}.row{display:flex;flex-wrap:wrap;gap:12rpx;margin:10rpx 0;align-items:center}.chip{font-size:22rpx;padding:6rpx 16rpx;border-radius:20rpx;background:#eef4fd;color:#075dcc}.edit-field{padding:10rpx 0;border-bottom:1rpx solid #eef1f5}.error-text{color:#a02b36;margin:16rpx 0;font-size:25rpx}
