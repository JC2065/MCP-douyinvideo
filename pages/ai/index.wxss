.ai-page{padding-bottom:50rpx}.ai-page .strong{font-size:27rpx}.key-row{margin:8rpx 0 14rpx}.key-name{display:block;margin-bottom:6rpx}.key-input{margin:0}.ai-page .input{margin:8rpx 0}.scene-card .chips{margin-top:14rpx}.scene-prompt{box-sizing:border-box;width:100%;height:140rpx;padding:16rpx;background:#edf3fa;border-radius:16rpx;margin:12rpx 0 8rpx;font-size:26rpx;line-height:1.6}.ai-save{flex:1}.bundle-ops{gap:12rpx;align-items:center}.bundle-btn{flex:1}.bundle-label{display:block;margin-top:14rpx}.chip-off{opacity:.45}
.insight-card{padding-bottom:18rpx}.tier-badge{margin-left:12rpx;padding:2rpx 12rpx;border-radius:999rpx;background:rgba(7,93,204,.1);color:#075dcc;font-size:20rpx;vertical-align:middle}.score{font-size:34rpx;font-weight:700;color:#075dcc}.free-row{display:flex;flex-wrap:wrap;gap:10rpx;margin:12rpx 0}.free-pill{padding:4rpx 14rpx;border-radius:999rpx;background:rgba(22,163,74,.12);color:#15803d;font-size:21rpx;line-height:1.7}.free-pill.api{background:rgba(7,93,204,.08);color:#075dcc}.insight-foot{justify-content:space-between;align-items:center;margin-top:10rpx}.insight-note{display:block;margin:4rpx 0 8rpx;line-height:1.6}
