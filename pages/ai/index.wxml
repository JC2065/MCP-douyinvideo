<app-navigation class="app-navigation" title="模型与技能"/>
<view class="shell ai-page"><view class="eyebrow">AI MODELS & SKILLS</view><view class="heading">模型与技能</view><view class="sub">选一个默认模型，再为每个功能单独调整。</view>
 <view class="section">01 默认模型</view>
 <view class="card"><view class="chips"><text wx:for="{{modelsView}}" wx:key="id" class="chip {{state.defaultModel===item.id?'active':''}}" data-id="{{item.id}}" bindtap="chooseDefault">{{item.name}}</text></view><view class="body" wx:for="{{models}}" wx:key="id" wx:if="{{state.defaultModel===item.id}}">{{item.vendor}} · {{item.desc}}</view><text class="muted">各功能默认使用此模型；下方可逐功能覆盖。</text></view>
 <view class="section">02 模型测评与免费信息</view>
 <view class="card insight-card" wx:for="{{insightsView}}" wx:key="id"><view class="row"><view><text class="strong">{{item.name}}</text><text class="tier-badge">{{item.tier}}</text></view><text class="score">{{item.score}}</text></view><view class="free-row"><text class="free-pill">{{item.freeApp}}</text><text class="free-pill api">{{item.freeApi}}</text></view><view class="body">{{item.oneLiner}}</view><view class="row insight-foot"><text class="muted">擅长：{{item.goodForText}}</text><button class="small {{item.isDefault?'secondary':'primary'}}" data-id="{{item.id}}" bindtap="chooseDefault">{{item.isDefault?'当前默认':'设为默认'}}</button></view></view>
 <text class="muted insight-note">评分综合 2026 年公开测评（{{insightsUpdated}} 整理），免费政策以各厂商官网为准；非实时榜单。</text>
 <view class="section">03 模型钥匙（API Key）</view>
 <view class="card"><view class="key-row" wx:for="{{models}}" wx:key="id"><text class="strong key-name">{{item.name}}</text><input class="input key-input" password placeholder="填入 API Key（可选）" value="{{state.keys[item.id]}}" data-id="{{item.id}}" bindinput="keyInput" maxlength="200"/></view><text class="muted">Key 仅保存在本机。</text></view>
 <view class="section">04 自定义模型</view>
 <view class="card"><view class="row" wx:for="{{modelsView}}" wx:key="id" wx:if="{{item.baseUrl!==undefined&&item.id[0]==='c'}}"><view><view class="strong">{{item.name}}</view><text class="muted">{{item.model}} · {{item.baseUrl||'未填地址'}}</text></view><button class="small secondary" data-id="{{item.id}}" bindtap="removeCustom">删除</button></view><input class="input" placeholder="名称，例如：团队私有模型" value="{{draft.name}}" data-field="name" bindinput="customField" maxlength="12"/><input class="input" placeholder="接口地址 baseUrl（可选）" value="{{draft.baseUrl}}" data-field="baseUrl" bindinput="customField" maxlength="200"/><input class="input" placeholder="模型名，例如：team-v1（可选）" value="{{draft.model}}" data-field="model" bindinput="customField" maxlength="60"/><input class="input" password placeholder="API Key（可选）" value="{{draft.key}}" data-field="key" bindinput="customField" maxlength="200"/><button class="secondary" bindtap="addCustom">添加自定义模型</button><text class="muted">最多 3 个，可设为默认模型或被单个功能引用。</text></view>
 <view class="section">05 功能场景</view>
 <view class="card scene-card" wx:for="{{scenesView}}" wx:key="id"><view class="row"><view><view class="strong">{{item.name}}</view><text class="muted">{{item.desc}}</text></view><switch checked="{{item.cfg.enabled}}" data-id="{{item.id}}" bindchange="sceneToggle" color="#075dcc"/></view><block wx:if="{{item.cfg.enabled}}"><view class="chips"><text class="chip {{item.cfg.model===''?'active':''}}" data-id="{{item.id}}" data-model="" bindtap="sceneModel">跟随全局</text><text wx:for="{{modelsView}}" wx:for-item="m" wx:key="id" class="chip {{item.cfg.model===m.id?'active':''}}" data-id="{{item.id}}" data-model="{{m.id}}" bindtap="sceneModel">{{m.name}}</text></view><textarea class="editor scene-prompt" placeholder="自定义提示词（留空使用默认）" value="{{item.cfg.prompt}}" data-id="{{item.id}}" bindinput="scenePrompt" maxlength="500"/><block wx:if="{{state.bundles.length}}"><view class="strong bundle-label">工具包<text class="muted">（{{item.resolved.bundlesCustomized?'本场景勾选':'跟随全局'}}）</text></view><view class="chips"><text wx:for="{{state.bundles}}" wx:for-item="b" wx:key="id" class="chip {{item.bundleState[b.id]?'active':''}} {{b.enabled?'':'chip-off'}}" data-id="{{item.id}}" data-bundle="{{b.id}}" bindtap="sceneBundle">{{b.name}}{{b.enabled?'':'（已全局停用）'}}</text></view></block><text class="muted">生效：{{item.resolved.modelName}} · {{item.resolved.overridden?'本场景单独指定':'跟随全局'}} · {{item.resolved.prompt?'自定义提示词':'默认提示词'}} · {{item.resolved.bundles.length}} 个工具包</text></block><text wx:else class="muted">已停用：该功能入口保留，调用时提示先启用。</text></view>
 <view class="section">06 MCPB 工具包</view>
 <view class="card"><view class="row" wx:for="{{state.bundles}}" wx:key="id"><view><view class="strong">{{item.name}}<text class="muted">{{item.version?' v'+item.version:''}}{{item.publisher?' · '+item.publisher:''}}</text></view><text class="muted">{{item.source==='link'?item.url:item.fileName}}{{item.tools.length?' · '+item.tools.length+' 个工具':' · 清单待解析'}}</text></view><view class="row bundle-ops"><switch checked="{{item.enabled}}" data-id="{{item.id}}" bindchange="bundleToggle" color="#075dcc"/><button class="small secondary" data-id="{{item.id}}" bindtap="removeBundle">删除</button></view></view><view class="body" wx:if="{{!state.bundles.length}}">还没有工具包。安装后可在上方每个功能场景里单独勾选使用哪些工具包。</view><input class="input" placeholder="粘贴 .mcpb 链接，https://…/xxx.mcpb" value="{{bundleLink}}" bindinput="bundleLinkInput" maxlength="300"/><view class="row actions"><button class="secondary bundle-btn" bindtap="addBundleLink">链接安装</button><button class="secondary bundle-btn" bindtap="uploadBundle">从聊天选择 .mcpb 文件</button></view><text class="muted">最多保存 5 个工具包清单。</text></view>
 <view class="error-message" wx:if="{{error}}">{{error}}</view>
 <view class="row actions"><button class="secondary" bindtap="reset">恢复默认</button><button class="primary ai-save" bindtap="save">保存配置</button></view>
 <view class="sub">配置即时写入本机；接入真实模型后，各功能按「场景覆盖优先，其次全局默认」生效。</view>
</view>
