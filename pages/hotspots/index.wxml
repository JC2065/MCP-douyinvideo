<app-navigation class="app-navigation" title="热点变化"/>
<view class="shell hotspot-page">
 <view class="heading">哪些话题正在升温？</view>
 <view class="sub">看榜内位置的变化，找到值得继续关注的话题。</view>
 <view class="hotspot-modes"><button class="{{mode==='rising'?'primary':'secondary'}}" data-mode="rising" bindtap="mode">正在升温</button><button class="{{mode==='new'?'primary':'secondary'}}" data-mode="new" bindtap="mode">新上榜</button><button class="{{mode==='rank'?'primary':'secondary'}}" data-mode="rank" bindtap="mode">完整榜</button></view>
 <view class="search-row"><input value="{{query}}" bindinput="input" bindconfirm="send" maxlength="100" confirm-type="search" placeholder="搜索当前榜单中的话题"/><button class="secondary" bindtap="send">搜索</button></view>
 <view wx:if="{{mode==='chat'}}" class="row"><text class="muted">{{reply}}</text><text class="link" data-mode="rising" bindtap="mode">返回升温</text></view>
 <scroll-view class="hotspot-platforms" scroll-x enhanced show-scrollbar="{{false}}"><view class="category-track"><text class="chip {{platform===item?'active':''}}" wx:for="{{platforms}}" wx:key="*this" data-platform="{{item}}" bindtap="platform">{{item}}</text></view></scroll-view>
 <view class="row"><text class="muted">{{feedStatus}}</text><text class="link" bindtap="reload">刷新</text></view>
 <view class="muted">升温表示同平台榜内位置上升；新上榜表示新进入本次采集范围。</view>
 <view wx:if="{{error}}" class="card error-message">{{error}}</view>
 <view class="empty" wx:if="{{!visible.length}}">{{mode==='rising'?'暂未发现有效的上升记录。下一轮数据每10分钟同步，也可切换完整榜。':mode==='new'?'当前没有新入采集榜的话题，可查看正在升温或完整榜。':'没有匹配话题，请切换平台或关键词。'}}</view>
 <view class="card trend-row" wx:for="{{visible}}" wx:key="id"><view class="trend-heading" data-id="{{item.id}}" bindtap="detail"><text class="trend-change {{item.trend==='new'?'is-new':''}}">{{item.trendLabel}}</text><view class="grow"><view class="strong">{{item.title}}</view><view class="case-meta"><text class="badge">{{item.platform}}</text><text class="muted">{{item.evidence}}</text></view></view></view><view class="muted comparison">{{item.comparisonLabel}}</view><view class="trend-actions"><text class="link" data-id="{{item.id}}" bindtap="detail">查看话题</text><text class="link" data-id="{{item.id}}" bindtap="create">用话题创作</text></view></view>
 <view wx:if="{{selected}}" class="detail-mask" bindtap="close"><view class="card detail-sheet" catchtap="noop"><view class="row"><text class="strong">话题内容</text><text class="link" bindtap="close">关闭</text></view><view class="heading">{{selected.title}}</view><view class="topic-content"><view class="section">相关内容</view><view wx:if="{{contentLoading}}" class="body">正在查找相关报道与视频…</view><view wx:if="{{content}}" class="muted">{{content.notice}}</view><view wx:if="{{content&&!contentLoading&&!content.items.length}}" class="body">{{content.status==='empty'?'没有检索到足够相关的内容，可复制原平台话题链接核对。':''}}</view><view class="source-excerpt" wx:for="{{content.items}}" wx:key="id"><view class="strong">{{item.title}}</view><view class="body">{{item.excerpt}}</view><view class="muted">{{item.source}} · {{item.contentType}}</view><view wx:if="{{item.publishedAt}}" class="muted">检索条目时间：{{item.publishedAt}}</view><view class="trend-actions"><text class="link" data-id="{{item.id}}" bindtap="copyContent">复制原文链接</text><text wx:if="{{item.isVideo}}" class="link" data-id="{{item.id}}" bindtap="viewVideo">解析原视频</text></view></view><button wx:if="{{!contentLoading&&content&&content.status!=='ready'}}" class="secondary" bindtap="retryContent">重新获取内容</button><view class="muted" wx:if="{{content.retrievedAt}}">内容按需检索并缓存30分钟，摘录不代表已核实结论。</view></view><view class="section">热榜变化</view><view class="trend-change">{{selected.trendLabel}}</view><view class="body">{{selected.platform}} · {{selected.evidence}} · {{selected.comparisonLabel}}</view><view class="rank-trail"><view wx:for="{{selected.trail}}" wx:key="at"><text>{{item.label}}</text><text>{{item.position}}</text></view></view><view class="muted">{{selected.stale?'当前为缓存，上述变化只发生在最后成功采集时。':'榜内序号由来源返回顺序决定，变化不等同播放量或互动量增长。'}}</view><view class="trend-actions"><text wx:if="{{selected.url}}" class="link" data-id="{{selected.id}}" bindtap="copySource">复制来源</text><text class="link" data-id="{{selected.id}}" bindtap="save">存入灵感</text></view><button class="primary" data-id="{{selected.id}}" bindtap="create">用话题创作</button></view></view>
</view>
