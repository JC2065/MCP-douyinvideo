.hotspot-page{padding-bottom:40rpx}.demo-notice{font-size:21rpx;line-height:1.5;color:#56657a;padding:12rpx 16rpx;background:#ffffffa8;border-radius:18rpx}.hotspot-modes{display:flex;gap:12rpx;margin:14rpx 0}.hotspot-modes button{flex:1}.hotspot-platforms{white-space:nowrap;margin:12rpx 0}.hotspot-platforms .chip{min-height:64rpx}.search-row{display:flex;align-items:center;gap:10rpx}.search-row input{flex:1;min-width:0;font-size:24rpx;min-height:88rpx}.search-row button{width:auto;min-width:110rpx;padding:12rpx 20rpx}.chat-box .link{margin:0}.reply{font-size:24rpx;line-height:1.6;margin-bottom:10rpx}.trend-row{padding:14rpx 18rpx;margin:8rpx 0}.trend-heading{display:flex;gap:14rpx}.trend-number{min-width:32rpx;color:#075dcc;font-weight:700}.trend-row .case-meta{margin-top:8rpx}.trend-actions{display:flex;justify-content:flex-end;gap:24rpx}.trend-actions .link{font-size:23rpx;min-height:64rpx;margin:4rpx 0 0}.error-message{color:#a02b36}.detail-mask{position:fixed;inset:0;background:#18243866;z-index:30;display:flex;align-items:flex-end}.detail-sheet{width:100%;margin:0;padding:24rpx 24rpx calc(24rpx + env(safe-area-inset-bottom));max-height:75vh;overflow:auto}.detail-sheet .heading{font-size:30rpx}.detail-sheet .link{margin:0}
.trend-change{color:#127d5b;font-size:24rpx;font-weight:700;white-space:nowrap}.trend-change.is-new{color:#a66514}.comparison{margin:12rpx 0}.rank-trail{display:flex;flex-wrap:wrap;gap:16rpx;margin:24rpx 0}.rank-trail view{display:flex;flex-direction:column;gap:8rpx;padding:12rpx;border-bottom:2rpx solid #c8d9ea;font-size:22rpx}.hotspot-modes button{font-size:24rpx;padding:8rpx}.trend-heading{align-items:flex-start}.trend-heading>.trend-change{max-width:180rpx;white-space:normal}.trend-actions{justify-content:space-between}
.topic-content{margin:20rpx 0}.source-excerpt{margin:18rpx 0;padding:18rpx 0;border-bottom:1rpx solid #dce7f3}.source-excerpt .body{font-size:25rpx;line-height:1.7}.topic-content .muted{overflow-wrap:anywhere;word-break:break-all}.detail-sheet{max-height:85vh}
