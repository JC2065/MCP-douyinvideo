.interface-tools{display:flex;flex-wrap:wrap;gap:12rpx;margin:24rpx 0}.interface-tools .interface-tool{width:calc((100% - 24rpx) / 3);margin:0;min-width:0;box-sizing:border-box;display:flex;flex-direction:column;align-items:center;gap:8rpx;padding:18rpx 6rpx;font-size:24rpx;line-height:1.4;background:rgba(255,255,255,.85);border:2rpx solid transparent;border-radius:20rpx}.interface-tool image{width:36rpx;height:36rpx}.interface-tool.selected{border-color:#83b6ff;background:#e5f0ff;color:#075dcc}.interface-tool-source{font-size:20rpx;color:#667892}.interface-config>.row{justify-content:space-between;gap:12rpx}.interface-config>.row>.muted{font-size:21rpx}.interface-sources{display:flex;gap:8rpx;background:#edf2f9;padding:6rpx;border-radius:18rpx;margin:22rpx 0}.interface-sources button{flex:1;font-size:24rpx;line-height:2.5;background:transparent;padding:0 8rpx;color:#54657d}.interface-sources .selected{background:white;color:#075dcc}.interface-label{font-size:24rpx;font-weight:600;margin:22rpx 0 8rpx}.interface-local{font-size:22rpx;color:#54657d}.interface-public{padding:10rpx 0}.interface-save{margin-top:24rpx}.interface-clear{background:transparent;color:#687993;font-size:23rpx;margin-top:12rpx}.interface-error{color:#a34040;font-size:24rpx;margin-top:16rpx}
