.creation-tool{padding-bottom:70rpx}.source-input{box-sizing:border-box;width:100%;height:180rpx;padding:18rpx;border-radius:16rpx;background:#f3f6fa;font-size:26rpx;line-height:1.55;margin-bottom:20rpx}.progress{display:flex;align-items:center;gap:20rpx;background:#f5f9ff}.spinner{width:38rpx;height:38rpx;border:5rpx solid #d8e8fb;border-top-color:#075dcc;border-radius:50%;animation:spin 1s linear infinite}@keyframes spin{to{transform:rotate(360deg)}}.error{color:#a02b36;background:#fff4f4;border-color:#ecc5cb}.result>.muted{margin-top:8rpx}.preview-video{width:100%;height:620rpx;background:#111;border-radius:18rpx;margin-top:20rpx}.preview-image{width:100%;border-radius:18rpx;margin-top:20rpx}.preview-audio{width:100%;margin-top:20rpx}.transcript{margin-top:20rpx;padding:20rpx;border-radius:16rpx;background:#f3f6fa;white-space:pre-wrap;line-height:1.8}.limit{margin-top:18rpx;color:#718095;font-size:21rpx;line-height:1.6}.script-editor{box-sizing:border-box;width:100%;height:260rpx;line-height:1.7}.prompt-settings button{width:48%;font-size:23rpx}.prompter{height:620rpx;background:#080808;color:#fff;border-radius:24rpx;padding:0 32rpx;text-align:center;line-height:1.65}.prompter-space{height:270rpx}.prompter.mirrored{transform:scaleX(-1)}.prompt-play{margin-top:20rpx;position:sticky;bottom:24rpx}
