.asset-library{padding-bottom:120rpx}.storage-note{margin:24rpx 0;padding:24rpx;border-radius:24rpx;background:#e7f1ff;color:#304866;line-height:1.6}.storage-note .strong{color:#132b48;margin-bottom:8rpx}.asset-item{margin-bottom:16rpx}.asset-meta{margin:12rpx 0 20rpx;color:#6a7c91;font-size:24rpx}.asset-actions{display:flex;gap:14rpx}.asset-actions button{flex:1;margin:0;font-size:24rpx}.boundary{padding:18rpx 8rpx;color:#75869a;font-size:23rpx;line-height:1.55}
.asset-filters{display:flex;gap:10rpx;flex-wrap:wrap;margin:20rpx 0}.asset-fulltext{display:block;white-space:pre-wrap;line-height:1.8;margin:24rpx 0;font-size:27rpx}.asset-error{color:#b43c3c;margin:16rpx 0}.asset-detail{border:1rpx solid #c4d9fc}
