page{background:#f5f8fc;color:#20314a}.console{padding:32rpx 32rpx 80rpx}.mast{border-top:8rpx solid #0868df;padding:30rpx 0}.title{font-size:42rpx;font-weight:700}.heading{font-size:32rpx;font-weight:650;margin:32rpx 0 18rpx}.muted{display:block;font-size:25rpx;color:#65748a;line-height:1.6}.login{background:#fff;padding:28rpx}.login input{border-bottom:2rpx solid #c8d4e2;height:92rpx;line-height:92rpx;padding:0 8rpx;margin:20rpx 0;font-size:30rpx}button{background:#0868df;color:#fff;font-size:29rpx;border-radius:12rpx;margin:24rpx 0}button[disabled]{background:#e0e8f1;color:#708095}.quiet{background:transparent;color:#0868df;font-size:27rpx}.toolbar{display:flex;justify-content:space-between}.toolbar button{margin:0}.tabs{white-space:nowrap;border-bottom:2rpx solid #d3dce8;margin:16rpx 0 24rpx}.tab{display:inline-block;padding:20rpx 26rpx;color:#65748a}.tab.active{color:#0868df;border-bottom:5rpx solid #0868df;font-weight:650}.line{display:flex;align-items:center;justify-content:space-between;padding:24rpx 0;border-bottom:2rpx solid #e0e7ef}.record{display:flex;flex-direction:column;gap:12rpx;background:#fff;border-left:5rpx solid #c7d8ed;padding:24rpx;margin:18rpx 0;line-height:1.5}.code{overflow-wrap:anywhere;font-size:22rpx}.error{background:#fff0ef;color:#9d3030;padding:22rpx;line-height:1.5;margin:16rpx 0}.empty{padding:40rpx 0;color:#65748a}.change{padding:12rpx;color:#0868df}.detail{border-top:6rpx solid #0868df;background:#fff;padding:26rpx;margin-top:32rpx}


.ai-scene input,.ai-scene textarea{width:100%;box-sizing:border-box;border:1rpx solid #cbd9eb;border-radius:12rpx;padding:18rpx;margin:12rpx 0 20rpx;background:#fff}.ai-scene input{height:88rpx;line-height:88rpx;padding:0 18rpx}.ai-scene textarea{height:140rpx}.ai-scene>text{display:block;margin-top:12rpx}.ai-scene .strong{font-size:30rpx;font-weight:650}.picker{border:1rpx solid #cbd9eb;border-radius:12rpx;padding:18rpx;margin:12rpx 0 20rpx;background:#fff;color:#20314a}.strong{font-weight:650}
