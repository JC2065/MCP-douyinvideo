<view class="console">
 <view class="mast"><view class="title">有AI管理中台</view><text class="muted">服务与内容统一管理</text></view>
 <view wx:if="{{error}}" class="error" role="alert">{{error}}</view>
 <view wx:if="{{!logged}}" class="login"><view class="heading">管理员登录</view><text class="muted">使用独立管理账号，微信登录不能授予管理权限。</text><input value="{{username}}" data-field="username" bindinput="field" placeholder="账号" maxlength="64"/><input password value="{{password}}" data-field="password" bindinput="field" placeholder="管理密码" maxlength="256"/><button bindtap="login" disabled="{{busy}}" loading="{{busy}}">登录中台</button></view>
 <block wx:else>
  <view class="toolbar"><button class="quiet" bindtap="refresh" disabled="{{busy}}">刷新</button><button class="quiet" bindtap="logout" disabled="{{busy}}">退出登录</button></view>
  <scroll-view scroll-x class="tabs"><text wx:for="{{sections}}" wx:key="*this" class="tab {{section===item?'active':''}}" data-section="{{item}}" bindtap="section">{{item}}</text></scroll-view>
  <text wx:if="{{busy}}" class="muted">正在读取管理服务…</text>
  <block wx:if="{{section==='总览'}}"><view class="heading">热点来源</view><view wx:for="{{sources}}" wx:key="key" class="line"><text>{{item.platform}}</text><text>{{item.status==='fresh'?'已更新':item.status==='stale'?'更新延迟':'不可用'}}</text></view><view class="heading">最近任务</view><text class="muted">{{taskScope}}</text><view wx:for="{{tasks}}" wx:key="id" class="record"><text>{{item.kind}} · {{item.status}}</text><text class="muted code">{{item.id}}</text><text wx:if="{{item.error}}" class="error">{{item.error}}</text></view><view wx:if="{{!tasks.length}}" class="empty">当前进程没有任务记录。</view></block>
  <block wx:if="{{section==='工具'}}"><view class="heading">工具维护</view><text class="muted">打开开关暂停工具，关闭恢复。发布后服务端立即生效，客户端提示在下次刷新配置时更新。</text><view wx:for="{{tools}}" wx:key="key" class="line"><text>{{item.name}}</text><switch checked="{{item.maintenance}}" data-key="{{item.key}}" bindchange="toggle" disabled="{{busy}}" color="#0868df"/></view><view wx:for="{{diff}}" wx:key="*this" class="change">{{item}}</view><button bindtap="publish" disabled="{{busy||!diff.length}}">确认并发布</button><text class="muted code">版本 {{revision}}</text></block>
  <block wx:if="{{section==='热点推荐'||section==='热点'||section==='作品拆解'}}">
   <view class="heading">灵感 AI 统一配置</view><text class="muted">修改后发布生效；密钥保留在服务器，客户端不回显。</text>
   <view class="record" wx:for="{{aiConnections}}" wx:key="id"><text>{{item.name}} · {{item.credentialConfigured?'凭据已配置':'未配置凭据'}}</text><text class="muted code">{{item.endpoint}}</text></view><text class="muted">{{aiNotice}}</text>
   <view wx:for="{{aiRows}}" wx:key="id" class="record"><view class="strong">{{item.name}} · {{item.enabled?'已启用':'已暂停'}}</view><text class="muted">业务：{{item.businessText}}</text><text class="muted">检测：{{item.probeText}}</text></view>
   <view class="record ai-scene" wx:for="{{aiRows}}" wx:key="id"><view class="strong">{{item.name}}</view><view class="line"><text>启用</text><switch checked="{{item.enabled}}" data-id="{{item.id}}" data-key="enabled" bindchange="aiField" disabled="{{busy}}" color="#0868df"/></view>
    <text>模型连接</text><picker range="{{aiConnections}}" range-key="name" value="{{item.connectionIndex}}" data-id="{{item.id}}" bindchange="aiConnection" disabled="{{busy}}"><view class="picker">{{aiConnections[item.connectionIndex].name||item.connection}} ›</view></picker><text>模型 ID</text><input value="{{item.model}}" data-id="{{item.id}}" data-key="model" bindinput="aiField" maxlength="80"/>
    <text>超时（5–40秒）</text><input type="number" value="{{item.timeoutSeconds}}" data-id="{{item.id}}" data-key="timeoutSeconds" bindinput="aiField"/>
    <text>输出上限（32–4096 Token）</text><input type="number" value="{{item.maxTokens}}" data-id="{{item.id}}" data-key="maxTokens" bindinput="aiField"/>
    <text>补充风格提示词</text><textarea value="{{item.instruction}}" data-id="{{item.id}}" data-key="instruction" bindinput="aiField" maxlength="1000"/>
    <text class="muted">最近业务：{{item.businessText}}</text><text class="muted">最近检测：{{item.probeText}}</text><text class="muted">{{item.calls}}次业务 / {{item.failures}}次失败</text><button class="quiet" data-id="{{item.id}}" bindtap="aiProbe" disabled="{{busy}}">检测连接（少量Token）</button>
   </view><button bindtap="aiPublish" disabled="{{busy}}">确认并发布 AI 配置</button><text class="muted code">AI版本 {{aiRevision}}</text>
   <view class="record" wx:for="{{aiVersions}}" wx:key="revision"><text class="muted code">{{item.time}} · {{item.revision}}</text><button class="quiet" data-revision="{{item.revision}}" bindtap="aiRollback" disabled="{{busy}}">恢复此 AI 版本</button></view>
   <text class="muted">搜索与榜位监测不调用AI；来源状态在总览查看。生成作品进入创作服务。</text>
<view class="heading">话题内容</view><text class="muted">查看内容状态；重新获取仍受缓存与并发限制。</text><view wx:for="{{topics}}" wx:key="id" class="record" data-id="{{item.id}}" bindtap="topic"><text>{{item.title}}</text><text class="muted">{{item.platform}} 第{{item.rank}}位 · 查看内容 ›</text></view><view wx:if="{{!topics.length}}" class="empty">暂无可用榜单，请稍后刷新。</view></block>
  <block wx:if="{{section==='模型与密钥'}}"><view class="heading">模型与密钥</view><text class="muted">{{platformNotice}}</text>
   <view wx:for="{{platformConnections}}" wx:key="id" class="record ai-scene"><view class="strong">{{item.name}}</view><text class="muted code">{{item.endpoint}}</text><text class="{{item.credential.configured?'muted':'error'}}">{{item.credText}}</text>
    <input password value="" placeholder="输入新密钥（只写不读）" maxlength="512" data-id="{{item.id}}" bindinput="secretInput"/><button class="quiet" data-id="{{item.id}}" data-name="{{item.name}}" bindtap="saveSecret" disabled="{{busy}}">保存新密钥</button><button wx:if="{{item.kind==='chat'}}" class="quiet" data-id="{{item.id}}" bindtap="connectionProbe" disabled="{{busy}}">检测连接（少量Token）</button></view>
   <text class="muted">新增自定义模型连接、视频生成参数请在网页中台修改。</text></block>
  <block wx:if="{{section==='流程'}}"><view class="heading">三阶段流程</view><text class="muted">{{flowNotice}}</text>
   <view wx:for="{{flows}}" wx:key="stage" class="record"><view class="strong">{{item.name}}</view><text class="muted code">当前发布 {{item.published.version}}</text><text wx:for="{{item.published.steps}}" wx:for-item="step" wx:key="id">{{index+1}}. {{step.title}}{{step.required?'':'（可选）'}}</text>
    <block wx:if="{{item.draft}}"><view class="change">有未发布草案</view><text wx:for="{{item.diff}}" wx:for-item="line" wx:key="*this" class="change">{{line}}</text><text wx:for="{{item.errors}}" wx:for-item="line" wx:key="*this" class="error">{{line}}</text><button data-stage="{{item.stage}}" bindtap="flowPublish" disabled="{{busy||item.errors.length}}">发布草案</button><button class="quiet" data-stage="{{item.stage}}" bindtap="flowDiscard" disabled="{{busy}}">放弃草案</button></block>
    <button wx:if="{{item.published.version!=='default-v1'}}" class="quiet" data-stage="{{item.stage}}" bindtap="flowReset" disabled="{{busy}}">恢复系统默认流程</button></view>
   <text class="muted">编辑步骤请在网页中台进行；这里可审核发布、放弃草案和回到默认。</text></block>
  <block wx:if="{{section==='作品拆解'}}"><view class="record"><view class="heading">低成本视频观看</view><text class="muted">用量汇总（费用为人民币估算）：{{watchUsage}}</text><view wx:for="{{watchFields}}" wx:key="key"><text>{{item.key}}</text><input value="{{item.value}}" data-key="{{item.key}}" bindinput="watchField"/></view><text>自动深度观看（默认关闭）</text><switch checked="{{watchAuto}}" bindchange="watchAuto"/><text>模型单价JSON（元/百万Token）</text><textarea value="{{watchPrices}}" bindinput="watchPrices"/><button bindtap="publishWatch" disabled="{{busy}}">发布观看配置</button></view></block><block wx:if="{{section==='版本'}}"><view class="heading">配置历史</view><view wx:for="{{versions}}" wx:key="revision" class="record"><text>{{item.time}}</text><text class="muted code">{{item.revision}}</text><button class="quiet" data-revision="{{item.revision}}" bindtap="rollback" disabled="{{busy}}">恢复此版本</button></view><view wx:if="{{!versions.length}}" class="empty">发布配置后将保留版本。</view></block>
  <block wx:if="{{section==='审计'}}"><view class="heading">管理操作记录</view><view wx:for="{{audit}}" wx:key="index" class="record"><text>{{item.event}} · {{item.actor}}</text><text class="muted">{{item.time}}</text></view></block>
  <view wx:if="{{selected}}" class="detail"><view class="heading">内容状态：{{selected.status}}</view><text>{{selected.notice}}</text><view wx:for="{{selected.items}}" wx:key="url" class="record"><text>{{item.title}}</text><text class="muted">{{item.source}} · {{item.publishedAt}}</text><text class="muted">{{item.excerpt}}</text></view><button bindtap="retry" disabled="{{busy||!selected.topicId}}">重新获取内容</button><button class="quiet" data-id="{{selected.topicId}}" bindtap="topic" disabled="{{busy||!selected.topicId}}">刷新状态</button><button class="quiet" bindtap="close">关闭详情</button></view>
 </block>
</view>
