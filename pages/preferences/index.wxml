<app-navigation class="app-navigation" title="我的创作档案"/>
<view class="shell preferences-page" wx:if="{{profile}}">
 <view class="heading">让创作更像你</view><view class="sub">可随时调整；本次要求优先于默认偏好。</view>
 <scroll-view scroll-x class="pref-scroll"><view class="category-track"><text class="chip {{state.active===item.id?'active':''}}" wx:for="{{state.profiles}}" wx:key="id" data-id="{{item.id}}" bindtap="switchProfile">{{item.name}}</text><text class="chip" bindtap="add">＋ 新档案</text></view></scroll-view>
 <scroll-view scroll-x class="pref-scroll"><view class="category-track"><text class="chip {{section===item.id?'active':''}}" wx:for="{{sections}}" wx:key="id" data-id="{{item.id}}" bindtap="section">{{item.name}}</text></view></scroll-view>
 <view class="card" wx:if="{{section==='direction'}}"><view class="strong">档案名称</view><input class="input" value="{{profile.name}}" data-key="name" bindinput="field" maxlength="20"/><view class="strong">内容领域</view><view class="chips"><text class="chip {{profile.domain===item?'active':''}}" wx:for="{{options.domain}}" wx:key="*this" data-key="domain" data-value="{{item}}" bindtap="choose">{{item}}</text></view><view class="strong">想让谁看到？</view><input class="input" value="{{profile.audience}}" data-key="audience" bindinput="field" maxlength="100" placeholder="选填，例如刚开始工作的年轻人"/><view class="strong">创作目的</view><view class="chips"><text class="chip {{profile.goal===item?'active':''}}" wx:for="{{options.goal}}" wx:key="*this" data-key="goal" data-value="{{item}}" bindtap="choose">{{item}}</text></view><text class="muted">领域用于热点推荐；受众和目的作为你的档案信息，目前不会自动改写视频原文。</text></view>
 <view class="card" wx:if="{{section==='video'}}"><view class="strong">默认时长</view><view class="chips"><text class="chip {{profile.duration===item?'active':''}}" wx:for="{{options.duration}}" wx:key="*this" data-key="duration" data-value="{{item}}" bindtap="choose">{{item}}</text></view><view class="strong">视频目标</view><view class="chips"><text class="chip {{profile.videoGoal===item?'active':''}}" wx:for="{{options.videoGoal}}" wx:key="*this" data-key="videoGoal" data-value="{{item}}" bindtap="choose">{{item}}</text></view><view class="strong">开头方式</view><view class="chips"><text class="chip {{profile.hookStyle===item?'active':''}}" wx:for="{{options.hookStyle}}" wx:key="*this" data-key="hookStyle" data-value="{{item}}" bindtap="choose">{{item}}</text></view><view class="strong">视频感觉</view><view class="chips"><text class="chip {{profile.mood===item?'active':''}}" wx:for="{{options.mood}}" wx:key="*this" data-key="mood" data-value="{{item}}" bindtap="choose">{{item}}</text></view><view class="strong">表达语气</view><view class="chips"><text class="chip {{profile.tone===item?'active':''}}" wx:for="{{options.tone}}" wx:key="*this" data-key="tone" data-value="{{item}}" bindtap="choose">{{item}}</text></view><view class="strong">结尾引导</view><view class="chips"><text class="chip {{profile.cta===item?'active':''}}" wx:for="{{options.cta}}" wx:key="*this" data-key="cta" data-value="{{item}}" bindtap="choose">{{item}}</text></view><view class="strong">默认画面形式</view><view class="chips"><text class="chip {{profile.visualStyle===item?'active':''}}" wx:for="{{options.visualStyle}}" wx:key="*this" data-key="visualStyle" data-value="{{item}}" bindtap="choose">{{item}}</text></view><view class="strong">参考视频默认借鉴方式</view><view class="chips"><text class="chip {{profile.referenceMode===item?'active':''}}" wx:for="{{options.referenceMode}}" wx:key="*this" data-key="referenceMode" data-value="{{item}}" bindtap="choose">{{item}}</text></view><view class="strong">优先学习的视频形式</view><view class="chips"><text class="chip {{profile.form===item?'active':''}}" wx:for="{{options.form}}" wx:key="*this" data-key="form" data-value="{{item}}" bindtap="choose">{{item}}</text></view><text class="muted">本次创作中的明确选择会覆盖这些默认值。</text></view>
 <view class="card" wx:if="{{section==='flow'}}"><view class="strong">默认产物类型</view><view class="chips"><text class="chip {{profile.outputType===item.id?'active':''}}" wx:for="{{[{id:'video',name:'视频'},{id:'text',name:'文字'},{id:'image',name:'图片'}]}}" wx:key="id" data-key="outputType" data-value="{{item.id}}" bindtap="choose">{{item.name}}</text></view><view class="strong">先把预期说清楚</view><view class="chips"><text class="chip {{profile.expectationMode===item.id?'active':''}}" wx:for="{{[{id:'auto',name:'自动'},{id:'manual',name:'手动'}]}}" wx:key="id" data-key="expectationMode" data-value="{{item.id}}" bindtap="choose">{{item.name}}</text></view><view class="strong">分镜草案</view><view class="chips"><text class="chip {{profile.storyboardMode===item.id?'active':''}}" wx:for="{{[{id:'auto',name:'自动'},{id:'manual',name:'手动'}]}}" wx:key="id" data-key="storyboardMode" data-value="{{item.id}}" bindtap="choose">{{item.name}}</text></view><view class="strong">参考视频拆解重点</view><view class="chips"><text class="chip {{profile.analysisFocusMode===item.id?'active':''}}" wx:for="{{[{id:'auto',name:'自动'},{id:'manual',name:'手动'}]}}" wx:key="id" data-key="analysisFocusMode" data-value="{{item.id}}" bindtap="choose">{{item.name}}</text></view><button class="secondary" bindtap="analysisSettings">拆解模板、目标与 DIY 偏好 ›</button><view class="strong">代表帧采样</view><view class="chips"><text class="chip {{profile.frameSampling===item.id?'active':''}}" wx:for="{{[{id:'smart',name:'智能'},{id:'sparse',name:'精简'},{id:'standard',name:'正常'},{id:'detailed',name:'精细'},{id:'ultra',name:'超细'}]}}" wx:key="id" data-key="frameSampling" data-value="{{item.id}}" bindtap="choose">{{item.name}}</text></view><view class="strong">视频生成默认参数</view><view class="pref-label">清晰度</view><view class="chips"><text class="chip {{profile.generation.resolution===item?'active':''}}" wx:for="{{['480P','720P','1080P']}}" wx:key="*this" data-key="resolution" data-value="{{item}}" bindtap="generationOption">{{item}}</text></view><view class="pref-label">画幅</view><view class="chips"><text class="chip {{profile.generation.ratio===item?'active':''}}" wx:for="{{['adaptive','21:9','16:9','4:3','1:1','3:4','9:16']}}" wx:key="*this" data-key="ratio" data-value="{{item}}" bindtap="generationOption">{{item==='adaptive'?'自动':item}}</text></view><view class="setting-switch"><text>声音</text><switch checked="{{profile.generation.audio}}" data-key="audio" bindchange="generationToggle" color="#075dcc"/></view><view class="setting-switch"><text>智能优化提示词</text><switch checked="{{profile.generation.promptExtend}}" data-key="promptExtend" bindchange="generationToggle" color="#075dcc"/></view><view class="setting-switch"><text>AI 生成水印</text><switch checked="{{profile.generation.watermark}}" data-key="watermark" bindchange="generationToggle" color="#075dcc"/></view></view>
 <view class="card" wx:if="{{section==='boundaries'}}"><view class="strong">默认边界模式</view><view class="chips"><text class="chip {{profile.boundaryMode===item.id?'active':''}}" wx:for="{{[{id:'auto',name:'自动'},{id:'manual',name:'手动'}]}}" wx:key="id" data-key="boundaryMode" data-value="{{item.id}}" bindtap="choose">{{item.name}}</text></view><view class="strong">内容边界适用平台 · 可多选</view><view class="chips"><text class="chip {{item.selected?'active':''}}" wx:for="{{boundaryOptions}}" wx:key="id" data-key="boundaryPlatforms" data-id="{{item.id}}" bindtap="boundaryPlatform">{{item.name}}</text></view><view class="strong">发布平台默认选择 · 可多选</view><view class="chips"><text class="chip {{item.selected?'active':''}}" wx:for="{{publishOptions}}" wx:key="id" data-key="publishPlatforms" data-id="{{item.id}}" bindtap="boundaryPlatform">{{item.name}}</text></view><view class="strong">必须出现</view><textarea class="pref-text" value="{{profile.mustInclude}}" data-key="mustInclude" bindinput="field" maxlength="120" placeholder="例如：产品名称、关键步骤、准确数字"/><view class="strong">不要出现</view><textarea class="pref-text" value="{{profile.avoid}}" data-key="avoid" bindinput="field" maxlength="120" placeholder="例如：夸张承诺、人物露脸、竞品名称"/><text class="muted">平台规则会随已选平台带入创作。本次手动修改不会覆盖档案默认值。</text></view>
 <view class="card" wx:if="{{section==='topics'}}"><view class="strong">关注关键词</view><textarea class="pref-text" value="{{keywordText}}" bindinput="keywords" maxlength="250" placeholder="用顿号分隔，例如：口红、咖啡、旅行"/><view class="muted">最多 12 个，保存后出现在热点聊天的快捷入口。</view><view class="strong">默认热点平台</view><view class="chips"><text class="chip {{profile.platform===item?'active':''}}" wx:for="{{options.platform}}" wx:key="*this" data-key="platform" data-value="{{item}}" bindtap="choose">{{item}}</text></view></view>
 <view class="card" wx:if="{{section==='agent'}}"><view class="row"><text class="strong">应用当前档案偏好</text><switch checked="{{profile.useDefaults}}" bindchange="enabled" color="#075dcc"/></view><view class="strong">生成视频前如何配合你</view><view class="chips"><text class="chip {{profile.assistant===item?'active':''}}" wx:for="{{options.assistant}}" wx:key="*this" data-key="assistant" data-value="{{item}}" bindtap="choose">{{item}}</text></view><view class="strong">我希望助手记住</view><textarea class="pref-text" value="{{profile.memory}}" data-key="memory" bindinput="field" maxlength="500" placeholder="选填，例如不要夸张营销语，优先用自己的素材"/><view class="row"><text class="muted">仅由你编辑，不自动推测或写入。</text><text class="link" bindtap="clearMemory">清空</text></view><view class="section">各类 AI 调用的个人提示</view><text class="muted">只补充你的表达偏好，平台边界、事实准确和服务端安全规则始终优先。模型由已配置的服务连接提供。</text><view class="strong">灵感与 AI 对话</view><textarea class="pref-text" value="{{profile.aiInstructions.topic}}" data-scene="topic" bindinput="aiInstruction" maxlength="500" placeholder="例如：先理解我的目标，再给可直接拍摄的切入点"/><view class="strong">热点总结</view><textarea class="pref-text" value="{{profile.aiInstructions.hotspot}}" data-scene="hotspot" bindinput="aiInstruction" maxlength="500" placeholder="例如：优先关注生活方式和美食相关话题"/><view class="strong">文字作品</view><textarea class="pref-text" value="{{profile.aiInstructions.text}}" data-scene="text" bindinput="aiInstruction" maxlength="500" placeholder="例如：少用口号，多写具体场景和动作"/><view class="strong">图片生成</view><textarea class="pref-text" value="{{profile.aiInstructions.image}}" data-scene="image" bindinput="aiInstruction" maxlength="500" placeholder="例如：画面有留白，保留素材特点，不套固定风格"/><view class="strong">视频生成</view><textarea class="pref-text" value="{{profile.aiInstructions.video}}" data-scene="video" bindinput="aiInstruction" maxlength="500" placeholder="例如：画面自然，避免夸张镜头和画面文字"/></view>

 <view class="card" wx:if="{{section==='memory'}}"><view class="strong">TA 对你的了解</view><view class="sub">{{memory.notice||'TA 会根据你对选题的“喜欢 / 不想要”、采纳的选题和保存的作品，慢慢记住你的创作偏好。'}}</view>
  <view wx:if="{{!memoryLogged}}" class="muted">登录后可查看 TA 学到的偏好。</view>
  <block wx:else>
   <view class="memory-switch"><text>个性化推荐</text><switch checked="{{memory.enabled}}" color="#0968e8" bindchange="memoryToggle" disabled="{{memoryBusy}}"/></view>
   <view wx:if="{{memory&&!memory.serviceEnabled}}" class="muted">个性化学习暂未开放，你的反馈仍会被记录。</view>
   <view wx:if="{{memoryError}}" class="error-message">{{memoryError}}</view>
   <view wx:if="{{memory&&!memory.items.length}}" class="muted">还没有学到稳定的偏好。在灵感页给选题点“喜欢”或“不想要”，同一类方向累计 {{memory.minEvidence}} 次后会出现在这里。</view>
   <view wx:for="{{memory.items}}" wx:key="value" class="memory-item"><view class="memory-text"><text class="memory-facet">{{item.facetName}}</text><text class="strong">{{item.value}}</text><text class="memory-count">依据 {{item.evidence}} 次</text></view><text class="link" data-facet="{{item.facet}}" data-value="{{item.value}}" bindtap="memoryRemove">删除</text></view>
   <text wx:if="{{memory&&memory.items.length}}" class="link memory-clear" bindtap="memoryClear">清空全部了解</text>
  </block>
 </view>
 <view class="error-message" wx:if="{{error}}">{{error}}</view><button wx:if="{{section!=='memory'}}" class="primary pref-save" bindtap="save">{{saved?'已保存':'保存偏好'}}</button><view class="sub">档案切换会保存当前修改。仅保存在本机，清除缓存后可能丢失。</view><text class="link" bindtap="reset">恢复当前档案默认设置</text>
</view>
