.preferences-page{padding-bottom:50rpx}.pref-scroll{white-space:nowrap;margin:12rpx 0}.pref-scroll .chip{min-height:72rpx}.preferences-page .strong{font-size:27rpx}.preferences-page .input{margin:10rpx 0 20rpx}.pref-text{box-sizing:border-box;width:100%;height:160rpx;padding:16rpx;background:#edf3fa;border-radius:16rpx;margin:12rpx 0;font-size:26rpx;line-height:1.6}.preferences-page .muted{line-height:1.6}.pref-save{width:100%;margin-top:18rpx}.error-message{color:#a02b36;padding:16rpx}
.memory-switch{display:flex;align-items:center;justify-content:space-between;padding:18rpx 0;border-bottom:1rpx solid #e3eaf3}.memory-item{display:flex;align-items:center;justify-content:space-between;gap:16rpx;padding:18rpx 0;border-bottom:1rpx solid #edf1f6}.memory-text{display:flex;flex-direction:column;gap:4rpx;min-width:0}.memory-facet{font-size:22rpx;color:#6a7b90}.memory-count{font-size:22rpx;color:#8a99ab}.memory-clear{display:block;margin-top:20rpx;color:#a02b36}
