<app-navigation class="app-navigation" title="做私域，有AI"/>
<view class="shell video-studio">
<view wx:if="{{stage==='watch-chat'}}" class="card watch-chat"><view class="strong">聊聊想做什么 · {{watchTurn}} / {{watchMaxTurns}}</view><view wx:for="{{watchTurns}}" wx:key="index" class="watch-timeline"><text class="strong">{{item.role}}</text><view>{{item.text}}</view></view><button wx:for="{{watchDirections}}" wx:key="*this" data-direction="{{item}}" bindtap="sendWatchChat" disabled="{{watchBusy||watchTurn>=watchMaxTurns}}">{{item}}</button><textarea value="{{watchMessage}}" bindinput="watchInput" maxlength="1000" placeholder="说说想保留、改变什么，也可以纠正理解"/><button bindtap="sendWatchChat" disabled="{{watchBusy||watchTurn>=watchMaxTurns}}">发送</button><view class="strong">确认本次简报</view><view class="row"><button wx:for="{{['video','text','image']}}" wx:key="*this" data-type="{{item}}" bindtap="watchOutput">{{item==='video'?'视频':item==='text'?'文字':'图片'}}{{watchBrief.output===item?' ✓':''}}</button></view><input value="{{watchBrief.goal}}" data-key="goal" bindinput="watchBriefField" maxlength="120" placeholder="本次创作目标"/><textarea value="{{watchBrief.notes}}" data-key="notes" bindinput="watchBriefField" maxlength="1000" placeholder="补充要求"/><textarea value="{{watchKeepText}}" data-key="keep" bindinput="watchBriefField" placeholder="希望保留的内容，每行一条"/><textarea value="{{watchChangeText}}" data-key="change" bindinput="watchBriefField" placeholder="希望改变的内容，每行一条"/><button class="primary" bindtap="confirmWatchBrief" disabled="{{watchBusy}}">就这样做</button><view class="muted">只生成选择的产物；此步只确认简报，生成仍需确认费用。</view></view> <block wx:if="{{stage==='idea'}}">
<view wx:if="{{sourceType==='douyin'&&analysisStatus!=='idle'&&analysisStatus!=='failed'&&!inputOpen&&!quickBusy}}" class="card fold-bar" data-key="inputOpen" bindtap="toggleFold"><view class="fold-main"><text class="fold-label">参考视频</text><view class="fold-title">{{reference.source.title||reference.source.description||sourceValue}}</view></view><text class="fold-action">展开</text></view>
<block wx:else><view class="source-switch"><button wx:for="{{sourceModes}}" wx:key="id" class="source-option {{sourceType===item.id?'active':''}}" data-type="{{item.id}}" bindtap="selectSource"><text>{{item.label}}</text></button></view>
   <view wx:if="{{sourceType==='douyin'}}" class="sampling-control"><view class="sampling-head"><text class="strong">代表帧采样</text></view><view class="sampling-options"><button wx:for="{{frameSamplingOptions}}" wx:key="id" class="sampling-option {{frameSampling===item.id?'active':''}}" data-sampling="{{item.id}}" catchtap="selectFrameSampling" disabled="{{analysisStatus==='running'}}"><text>{{item.label}}</text></button></view></view>
   <view wx:if="{{sourceType==='douyin'&&analysisStatus==='done'}}" class="card analysis-focus-control"><view class="analysis-focus-head"><view class="strong">拆解重点</view><view class="analysis-mode-options"><button class="{{analysisFocusMode==='auto'?'active':''}}" data-mode="auto" catchtap="focusMode">自动</button><button class="{{analysisFocusMode==='manual'?'active':''}}" data-mode="manual" disabled="{{!templatePreview}}" catchtap="focusMode">手动</button></view></view><block wx:if="{{analysisFocusMode==='manual'&&templatePreview}}"><picker range="{{materialOptions}}" range-key="name" value="{{materialIndex}}" bindchange="materialChange"><view class="body">素材：{{templatePreview.materialLabel}} ▾</view></picker><picker range="{{templateOptions}}" range-key="name" value="{{templateIndex}}" bindchange="templateChange"><view class="body">模板：{{templatePreview.preset.name}} ▾</view></picker><view class="analysis-goals"><text wx:for="{{analysisGoals}}" wx:key="id" class="analysis-goal {{item.picked?'picked':''}}" data-id="{{item.id}}" bindtap="analysisGoal">{{item.name}}</text></view><button class="secondary" bindtap="analysisSettings">管理与 DIY 模板</button></block></view>
  <view class="row preference-toggle"><text class="muted">应用「{{creator.name}}」偏好</text><switch checked="{{usePreferences}}" bindchange="togglePreferences" color="#075dcc"/></view></block>
<form bindsubmit="interview">
<block wx:if="{{!(sourceType==='douyin'&&analysisStatus!=='idle'&&analysisStatus!=='failed'&&!inputOpen&&!quickBusy)}}"><view class="card capture {{sourceType==='douyin'?'capture-hero':''}}"><textarea class="{{sourceType==='douyin'?'capture-link':''}}" name="sourceValue" value="{{sourceValue}}" bindinput="input" bindblur="input" maxlength="{{sourceType==='command'?100000:sourceType==='douyin'?2000:160}}" placeholder="{{sourceType==='douyin'?'粘贴 https://v.douyin.com/...':sourceType==='command'?'粘贴 YOUAI1: 开头的模板口令':'例如：下班后，只想一个人静一静。'}}"/><view wx:if="{{(sourceType==='douyin'||sourceType==='command')&&!sourceValue}}" class="paste-chip" bindtap="pasteClipboard">📋 点这里粘贴{{sourceType==='douyin'?'链接':'口令'}}</view><view class="muted" wx:if="{{sourceType==='idea'}}">{{sourceValue.length}} / 160</view><view wx:if="{{sourceType==='douyin'&&referenceStatus!=='idle'}}" class="reference-state reference-{{referenceStatus}}" bindtap="retryReference"><view class="reference-head"><text>{{referenceMessage}}{{referenceNeedsConfig?'，点此去配置':referenceStatus==='failed'?'，点此重试':''}}</text><text wx:if="{{referenceElapsed}}" class="reference-elapsed">{{referenceElapsed}}</text></view><view wx:if="{{glance.overview&&referenceStatus==='checking'}}" class="peek-line"><text class="glance-tag">大致内容</text><text>{{glance.overview}}</text></view><view wx:if="{{referenceStep}}" class="reference-track"><view wx:for="{{['识别链接','平台解析','下载素材','校验视频']}}" wx:key="*this" class="reference-stage {{referenceStep>=index+1?'active':''}}"><text>{{referenceStep>index+1?'✓':index+1}}</text><view>{{item}}</view></view></view><view wx:if="{{referenceDetail}}" class="reference-detail">{{referenceDetail}}</view><view wx:if="{{referenceStatus==='checking'}}" class="reference-estimate">处理中阶段用于反馈等待进度，完成状态以服务返回为准。</view></view><view wx:if="{{sourceType==='douyin'}}" class="parse-row"><button class="secondary upload-original" bindtap="chooseReferenceVideo" disabled="{{referenceStatus==='checking'}}">上传原视频</button><button class="parse-btn {{referenceStatus==='checking'||quickBusy||parseFlash?'busy':analysisStatus==='running'?'soft':''}}" bindtap="parseTap" disabled="{{referenceStatus==='checking'||quickBusy||parseFlash||analysisStatus==='running'||(!sourceValue&&referenceStatus!=='acquired')}}"><view wx:if="{{referenceStatus==='checking'||quickBusy||parseFlash}}" class="parse-fill {{parseFlash?'full':''}}" style="width:{{referenceStatus==='checking'&&peekState==='loading'&&!parseFlash?(peekPct||0):parseFlash?100:(parsePct||0)}}%"></view><text class="parse-label">{{parseFlash?parseFlash:referenceStatus==='checking'&&peekState==='loading'?'正在看大致内容 '+(peekPct||0)+'%':referenceStatus==='checking'?'正在获取视频 '+(parsePct||0)+'%':quickBusy?'正在看大致内容 '+(parsePct||0)+'%':analysisStatus==='running'?'完整理解中 · 见下方':referenceStatus==='acquired'?'开始识别':referenceStatus==='failed'?'重新解析':'开始解析'}}</text></button></view></view>
<view wx:if="{{sourceType==='douyin'&&analysisStatus!=='idle'&&analysisStatus!=='failed'&&!quickBusy}}" class="fold-close" data-key="inputOpen" bindtap="toggleFold">收起</view>
</block>
<view class="card theme-field" wx:if="{{sourceType==='command'}}"><view class="strong">这次要讲什么？</view><input name="commandTheme" value="{{commandTheme}}" bindinput="themeInput" maxlength="100" placeholder="例如：秋天第一杯桂花拿铁"/></view>
   <button wx:if="{{sourceType!=='douyin'}}" class="primary" form-type="submit">开始创造成片</button>
  </form>
<view id="analysis-progress"></view><view wx:if="{{sourceType==='douyin'&&analysisStatus==='done'&&!progressOpen&&!(board.breakdown&&board.card)}}" class="card fold-bar" data-key="progressOpen" bindtap="toggleFold"><view class="fold-main"><text class="fold-label done">✓ {{analysisTitle}}</text><view class="fold-title">{{analysisElapsed}}</view></view><text class="fold-action">详情</text></view>
<view wx:if="{{sourceType==='douyin'&&analysisStatus==='done'&&board.breakdown&&board.card}}" class="card seen-card" bindlongpress="copyMenu" data-part="confirm"><view class="seen-card-head" data-key="seenClosed" bindtap="toggleFold"><text class="fold-label done">✓ 我看到的</text><text class="seen-card-time">{{analysisElapsed}}</text><text class="seen-card-toggle">{{seenClosed?'展开 ▾':'收起 ▴'}}</text></view>
 <view class="seen-card-body {{seenClosed?'clamp':''}}">{{board.card.overview}}</view>
 <block wx:if="{{!seenClosed}}"><view wx:if="{{board.card.type}}" class="watch-type"><text class="watch-chip strong">{{board.card.type}}</text><text wx:for="{{board.card.tags}}" wx:key="*this" class="watch-chip">#{{item}}</text></view>
  <view wx:if="{{board.card.timeline.length}}" class="seen-more" data-key="seenTimeline" catchtap="toggleFold">{{seenTimeline?'收起逐段画面 ▴':'看逐段画面（'+board.card.timeline.length+' 段）▾'}}</view>
  <view wx:if="{{seenTimeline}}" wx:for="{{board.card.timeline}}" wx:key="index" class="board-row"><text class="board-time">{{item.start}}–{{item.end}}秒</text><text class="board-what">{{item.what}}</text></view></block></view>
<view wx:if="{{sourceType==='douyin'&&analysisStatus!=='idle'&&!quickBusy&&(analysisStatus!=='done'||progressOpen)}}" class="card analysis-state analysis-{{analysisStatus}}" bindtap="retryAnalysis"><view class="reference-head"><text class="strong">{{analysisTitle}}</text><text wx:if="{{analysisStatus!=='running'}}" class="reference-elapsed">{{analysisElapsed}}</text></view><view class="analysis-track"><view class="analysis-node {{analysisStep>=1?'active':''}}"><text>1</text><view>画面与镜头</view></view><view class="analysis-node {{analysisStep>=2?'active':''}}"><text>2</text><view>声音与文案</view></view><view class="analysis-node {{analysisStep>=3?'active':''}}"><text>3</text><view>内容结构</view></view></view><view wx:if="{{analysisStatus==='running'&&(glance.overview||glanceState==='loading')}}" class="glance-box"><view class="glance-head"><text class="glance-tag">大致内容</text><text class="glance-note">{{glance.overview?'可以先看，完整理解中':'正在先看一眼，几秒后给出'}}</text><view wx:if="{{!glance.overview}}" class="glance-spin"></view></view><view wx:if="{{glance.overview}}" class="glance-line">大致是：{{glance.overview}}</view></view><view wx:if="{{analysisStatus!=='running'}}" class="reference-detail">{{analysisDetail}}{{analysisStatus==='failed'?'，点此重试':''}}</view><view wx:if="{{analysisStatus==='done'}}" class="analysis-evidence"><text wx:for="{{reference.analysis.reusableStrategies}}" wx:key="*this">{{item}}</text></view><view wx:if="{{analysisStatus==='running'&&analysisPercent}}" class="deep-progress"><view class="deep-head"><text class="deep-label">正在进行深度解析……</text><text class="deep-pct">{{analysisPercent}}%</text></view><view class="eta-bar"><view class="eta-fill" style="width:{{analysisPercent}}%"><view class="eta-shine"></view></view></view></view><button wx:if="{{analysisStatus==='running'&&analysisJobId}}" class="secondary queue-inline" catchtap="queueAnalysis" loading="{{queueBusy}}" disabled="{{queueBusy}}">不想等？后台排队，好了提醒我</button><view wx:if="{{analysisStatus==='done'}}" class="fold-close" data-key="progressOpen" catchtap="toggleFold">收起</view></view>
   <view wx:if="{{sourceType==='douyin'&&analysisStatus==='running'&&!quickBusy&&!tipsOff}}" class="tip-card" bindtap="nextTip" bindlongpress="tipMenu" aria-label="创作小提示，点一下换一条"><text class="tip-icon">💡</text><view class="tip-viewport tip-anim-{{tipFlip}}"><view class="tip-track {{tipShift?'scrolling':''}}" style="{{tipShift?'--tip-shift:-'+tipShift+'px;animation-duration:'+tipDur+'s':''}}"><text class="tip-line">{{tipText}}</text></view></view></view>
<view id="analysis-result"></view>
<view wx:if="{{(reference.analysis.analyzerVersion==='content-watch-4'||reference.analysis.analyzerVersion==='content-watch-5')&&analysisStatus==='done'&&!board.card}}" class="card watch-card"><view class="strong">{{reference.analysis.understanding.status==='ready'?'我看到的是…':'本地分析结果'}}</view><view class="body">{{reference.analysis.understanding.overview}}</view><view wx:if="{{reference.analysis.understanding.type}}" class="watch-type"><text class="watch-chip strong">{{reference.analysis.understanding.type}}</text><text wx:for="{{reference.analysis.understanding.tags}}" wx:key="*this" class="watch-chip">#{{item}}</text></view><view wx:if="{{reference.analysis.understanding.valueShares.length}}" class="muted">吸引力来自：<text wx:for="{{reference.analysis.understanding.valueShares}}" wx:key="key">{{item.label}} {{item.percent}}%　</text></view><view wx:if="{{reference.analysis.screenText.items.length}}" class="screen-text"><view class="strong">屏幕文字（自动识别）</view><block wx:for="{{reference.analysis.screenText.items}}" wx:key="index"><view wx:if="{{!item.persistent&&index<12}}" class="muted">{{item.start}}–{{item.end}} 秒 · {{item.text}}</view></block></view><view wx:if="{{reference.analysis.truncated}}" class="muted">仅分析前 {{reference.analysis.summary.durationSeconds}} 秒</view><view wx:for="{{reference.analysis.understanding.timeline}}" wx:key="index" class="watch-timeline"><view class="strong">{{item.start}}–{{item.end}} 秒</view><view>{{item.what}}</view><view class="muted">{{item.camera}} {{item.sound}} {{item.text}}</view></view><view>{{reference.analysis.understanding.audio.note}}</view><view class="muted">{{reference.analysis.audio.features.note}}</view><view wx:for="{{reference.analysis.understanding.uncertainties}}" wx:key="*this" class="muted">待核对：{{item}}</view><button wx:if="{{!watchDeep}}" bindtap="deepWatch" disabled="{{watchBusy}}">再仔细看一遍（会调用深度模型）</button></view><view wx:if="{{sourceType==='douyin'&&analysisStatus==='done'&&analysisUnderstanding&&(reference.analysis.analyzerVersion!=='content-watch-4'&&reference.analysis.analyzerVersion!=='content-watch-5')}}" class="card analysis-understanding"><view class="strong">{{reference.analysis.understanding.status==='ready'?'TA对这条视频的理解':'画面内容尚未识别完成'}}</view><view class="body">{{analysisUnderstanding}}</view><view wx:if="{{reference.analysis.understanding.status==='ready'}}" wx:for="{{reference.analysis.understanding.segments}}" wx:key="index" class="analysis-segment"><view class="strong">{{item.start}}–{{item.end}} 秒</view><view class="body">{{item.description}}</view></view><view wx:if="{{reference.analysis.audio.transcript.text}}" class="muted">音轨自动转写（可能含歌词或误识别，不等于口播或字幕）：{{reference.analysis.audio.transcript.text}}</view><button wx:if="{{reference.analysis.understanding.status!=='ready'}}" class="secondary" bindtap="confirmAnalysis">重新识别内容</button><view wx:for="{{reference.analysis.understanding.facts}}" wx:key="index" class="muted">依据 {{index+1}} · {{item.text}}<text wx:if="{{item.frameTimes.length}}">（画面 {{item.frameTimes}} 秒）</text><text wx:if="{{item.speechEvidence}}"> · 声音：{{item.speechEvidence}}</text></view><textarea value="{{referenceNotes}}" bindinput="referenceNotes" maxlength="1000" placeholder="纠正识别或补充内容，例如主角是我的宠物，应按动物日常来理解"/></view><include src="board.wxml"/>
<button wx:if="{{sourceType==='douyin'&&reference.asset.sha256&&analysisStatus!=='running'&&!board.card}}" class="secondary" bindtap="replicaHint">1:1 复刻</button>
  <view wx:if="{{sourceType==='douyin'&&(referenceStatus==='checking'||quickBusy||(boardPct>0&&boardPct<100))&&!tipsOff}}" class="tip-card tip-wait" bindtap="nextTip" bindlongpress="tipMenu" aria-label="创作小提示，点一下换一条"><text class="tip-icon">💡</text><view class="tip-viewport tip-anim-{{tipFlip}}"><view class="tip-track {{tipShift?'scrolling':''}}" style="{{tipShift?'--tip-shift:-'+tipShift+'px;animation-duration:'+tipDur+'s':''}}"><text class="tip-line">{{tipText}}</text></view></view></view>

  <view class="section creative-head"><view class="creative-tabs"><text class="creative-tab {{creativeTab!=='works'?'on':''}}" data-tab="drafts" catchtap="creativeTabPick">我的创作</text><text class="creative-sep">/</text><text class="creative-tab {{creativeTab==='works'?'on':''}}" data-tab="works" catchtap="creativeTabPick">我的作品</text></view><text class="creative-toggle" bindtap="toggleCreative">{{creativeClosed?(creativeTotal?creativeTotal+' 份 · ':'')+'展开 ▾':'收起 ▴'}}</text></view>
  <block wx:if="{{!creativeClosed}}"><view class="empty" wx:if="{{!creativeWorks.length}}">{{creativeTab==='works'?'还没有成品。拆解后生成文字作品、视频或图片，都会放在这里。':'还没有创作记录。粘贴一条抖音链接做爆款拆解，就会记录在这里。'}}</view>
  <view class="card creative-work" wx:for="{{creativeWorks}}" wx:key="key" data-key="{{item.key}}" bindtap="openCreativeWork"><view class="row"><text class="strong grow">{{item.title}}</text><text class="badge">{{item.label}}</text></view><view wx:if="{{item.preview||item.text}}" class="excerpt">{{item.preview||item.text}}</view><view class="creative-foot"><text class="muted">{{item.kind==='draft'?item.status:item.stage||'已保存'}}</text><text class="link">{{item.kind==='draft'?'继续编辑':item.kind==='analysis'?'打开拆解':item.kind==='replica'?'查看复刻':'查看作品'}} ›</text></view></view>
  <view wx:if="{{creativeTotal>creativeWorks.length}}" class="muted creative-more">只显示最近 {{creativeWorks.length}} 份，完整列表在首页</view></block>
 </block>
 <block wx:if="{{stage==='interview'}}">
  <view class="workflow-step">2/3·创造成片 · 对齐创作意图</view>
  <view class="card"><view class="strong">{{idea}}</view><view class="link" bindtap="edit">修改点子</view></view>
  <view class="card"><view class="strong">这次你想怎么创作？</view><textarea class="creative-intent" value="{{answers.creativeIntent}}" data-key="creativeIntent" bindinput="constraintInput" maxlength="1000" placeholder="自由描述你的想法、改编方向和希望保留的内容，下面的推荐都可以不选"/><text class="muted">选项是创作建议；本次明确要求优先于档案默认偏好。</text></view><view wx:if="{{contentSuggestions.length}}" class="card"><view class="strong">结合素材，推荐你这样做</view><view wx:for="{{contentSuggestions}}" wx:key="index" class="recommendation-row"><view class="strong">{{item.value}}</view><text class="muted">{{item.reason}}</text><button class="secondary" data-index="{{index}}" bindtap="recommendation">采用这条建议</button></view></view><view class="card expectation-control"><view class="analysis-focus-head"><view class="strong">先把预期说清楚</view><view class="analysis-mode-options"><button class="{{expectationMode==='auto'?'active':''}}" data-group="expectation" data-mode="auto" bindtap="creationMode">自动</button><button class="{{expectationMode==='manual'?'active':''}}" data-group="expectation" data-mode="manual" bindtap="creationMode">手动</button></view></view></view><block wx:if="{{expectationMode==='manual'}}">
  <view class="card" wx:for="{{questions}}" wx:key="key"><view class="strong">{{item.title}}</view><view class="chips"><text wx:for="{{item.options}}" wx:for-item="option" wx:key="*this" class="chip {{(answers[item.key]||'AI 决定')===option?'active':''}} {{item.key==='referenceMode'&&option==='高度参考原片'&&!highReferenceReady?'disabled':''}}" data-key="{{item.key}}" data-value="{{option}}" bindtap="answer">{{option}}</text></view><input wx:if="{{item.key!=='referenceMode'}}" class="input" value="{{answers[item.key]}}" data-key="{{item.key}}" bindchange="customAnswer" maxlength="120" placeholder="也可以写下你自己的想法"/><view wx:if="{{item.key==='referenceMode'}}" class="reference-channel {{highReferenceReady?'ready':''}}">{{highReferenceMessage}}</view></view>
</block>
  <view class="card constraint-card"><view class="analysis-focus-head"><view class="strong">内容边界</view><view class="analysis-mode-options"><button class="{{boundaryMode==='auto'?'active':''}}" data-group="boundary" data-mode="auto" bindtap="creationMode">自动</button><button class="{{boundaryMode==='manual'?'active':''}}" data-group="boundary" data-mode="manual" bindtap="creationMode">手动</button></view></view><view class="chips boundary-platforms"><text wx:for="{{boundaryPlatformOptions}}" wx:key="id" class="chip {{item.selected?'active':''}}" data-id="{{item.id}}" bindtap="boundaryPlatform">{{item.name}}</text></view><block wx:if="{{boundaryMode==='manual'}}"><view class="muted" wx:for="{{boundaryRules}}" wx:key="*this">{{item}}</view><view class="constraint-field"><text>必须出现</text><textarea value="{{answers.mustInclude}}" data-key="mustInclude" bindinput="constraintInput" maxlength="120" placeholder="例如：产品名称、关键步骤、准确数字"/></view><view class="constraint-field"><text>不要出现</text><textarea value="{{answers.avoid}}" data-key="avoid" bindinput="constraintInput" maxlength="120" placeholder="例如：夸张承诺、人物露脸、竞品名称"/></view></block></view>
  <view wx:if="{{outputType==='video'}}" class="card duration-card"><view class="duration-head"><view><view class="strong">成片多长？</view><text class="muted">{{durationMode==='smart'?'AI 判断，预计 '+durationValue+' 秒':durationValue+' 秒'}}</text></view><button class="smart-duration {{durationMode==='smart'?'active':''}}" bindtap="smartDuration">智能</button></view><slider min="2" max="30" step="1" value="{{durationValue}}" activeColor="#075dcc" backgroundColor="#d8e0eb" block-size="22" bindchange="durationChange"/><view class="duration-scale"><text>2s</text><text>30s</text></view></view>
  <view wx:if="{{outputType==='video'}}" class="card inline-storyboard"><view class="analysis-focus-head"><view class="strong">分镜草案</view><view class="analysis-mode-options"><button class="{{storyboardMode==='auto'?'active':''}}" data-mode="auto" bindtap="storyboardMode">自动</button><button class="{{storyboardMode==='manual'?'active':''}}" data-mode="manual" bindtap="storyboardMode">手动</button></view></view><view class="storyboard-timeline"><text wx:for="{{storyboard.shots}}" wx:key="role">{{item.start}}–{{item.end}}秒 · {{item.role}}</text></view><block wx:if="{{storyboardMode==='manual'}}"><view class="inline-shot" wx:for="{{storyboard.shots}}" wx:key="role"><view class="strong">{{item.role}} · {{item.start}}–{{item.end}}秒</view><text class="muted">内容文案</text><textarea value="{{item.narration}}" data-index="{{index}}" data-field="narration" bindinput="shotInput" maxlength="240"/><text class="muted">画面</text><textarea value="{{item.visual}}" data-index="{{index}}" data-field="visual" bindinput="shotInput" maxlength="240"/></view></block></view>
  <view class="card model-settings"><view class="generation-parameter-head"><view class="strong">生成参数</view><view class="output-type-options"><button class="{{outputType==='text'?'active':''}}" data-type="text" bindtap="outputType">文字</button><button class="{{outputType==='image'?'active':''}}" data-type="image" bindtap="outputType">图片</button><button class="{{outputType==='video'?'active':''}}" data-type="video" bindtap="outputType">视频</button></view></view><view wx:if="{{outputType==='text'}}" class="muted">千问文本生成 · 标题与正文</view><view wx:if="{{outputType==='image'}}" class="muted">生成一张完整图片</view><block wx:if="{{outputType==='image'}}"><view class="setting-label">图片画幅</view><view class="chips"><text wx:for="{{['adaptive','1:1','3:4','4:3','9:16','16:9']}}" wx:key="*this" class="chip {{(answers.imageRatio||'adaptive')===item?'active':''}}" data-ratio="{{item}}" bindtap="imageRatio">{{item==='adaptive'?'按内容推荐':item}}</text></view></block><block wx:if="{{outputType==='video'}}"><view class="setting-label">生成模式</view><view class="chips"><text class="chip {{answers.generation.mode==='all-purpose'?'active':''}}" data-key="mode" data-value="all-purpose" bindtap="generationOption">全能模式</text><text class="chip {{answers.generation.mode==='first-last-frame'?'active':''}} {{sourceType!=='douyin'||referenceStatus!=='analyzed'?'disabled':''}}" data-key="mode" data-value="first-last-frame" bindtap="generationOption">首尾帧</text></view><view class="setting-label">清晰度</view><view class="chips"><text wx:for="{{generationOptions.resolution}}" wx:key="*this" class="chip {{answers.generation.resolution===item?'active':''}}" data-key="resolution" data-value="{{item}}" bindtap="generationOption">{{item}}</text></view><view class="setting-label">宽高比</view><view class="chips"><text wx:for="{{generationOptions.ratio}}" wx:key="*this" class="chip {{answers.generation.ratio===item?'active':''}}" data-key="ratio" data-value="{{item}}" bindtap="generationOption">{{item==='adaptive'?'自动':item}}</text></view><view class="setting-switch"><text>声音</text><switch checked="{{answers.generation.audio}}" data-key="audio" bindchange="generationToggle" color="#075dcc"/></view><view class="setting-switch"><view><text>智能优化提示词</text><view class="muted">提高短提示词质量，但会增加等待时间</view></view><switch checked="{{answers.generation.promptExtend}}" data-key="promptExtend" bindchange="generationToggle" color="#075dcc"/></view><view class="setting-switch"><text>AI 生成水印</text><switch checked="{{answers.generation.watermark}}" data-key="watermark" bindchange="generationToggle" color="#075dcc"/></view></block></view>
  <button class="primary" bindtap="confirmCreation" loading="{{busy}}" disabled="{{busy}}">{{outputType==='text'?'生成文字':outputType==='image'?'生成图片':'确认分镜并生成'}}</button>
 </block>
 <block wx:if="{{stage==='text-history'}}"><view class="heading">我的文字作品</view><view wx:if="{{!textWorks.length}}" class="empty">还没有文字作品</view><view wx:for="{{textWorks}}" wx:key="id" class="card" data-id="{{item.id}}" bindtap="reopenText"><view class="strong">{{item.title}}</view><view class="link">查看文字</view></view><button class="secondary" bindtap="edit">返回创作</button></block><block wx:if="{{stage==='storyboard'}}"><view class="workflow-step">2/3·创造成片 · 审核分镜</view><view class="storyboard-intro"><view><view class="heading">先改方案，再生成</view><view class="sub">版本 {{storyboard.version}} · 每段内容都可以直接修改</view></view><text class="storyboard-mode">{{storyboard.referenceMode==='reference-video'?'高度参考':storyboard.referenceMode==='content-structure'?'借结构':storyboard.referenceMode==='visual-style'?'借画面':'做新作'}}</text></view><view wx:if="{{sourceType==='douyin'}}" class="reference-input-proof"><view class="strong">模型实际会看到</view><view>{{storyboard.referenceInputs.label}} · {{storyboard.referenceInputs.count}} 份素材</view><text>{{storyboard.referenceInputs.note}}</text></view><view class="storyboard-board"><view class="storyboard-shot" wx:for="{{storyboard.shots}}" wx:key="role"><view class="shot-time"><text>{{item.role}}</text><text>{{item.start}}–{{item.end}}s</text></view><view class="shot-editor"><text>这段说什么</text><textarea value="{{item.narration}}" data-index="{{index}}" data-field="narration" bindinput="shotInput" maxlength="240"/><text>画面怎么表现</text><textarea value="{{item.visual}}" data-index="{{index}}" data-field="visual" bindinput="shotInput" maxlength="240"/></view></view></view><view class="storyboard-check">确认后会把这版分镜、内容边界和上方参考素材一起提交给视频模型。</view><button class="primary" bindtap="approveStoryboard" disabled="{{busy}}">确认分镜并生成</button><button class="storyboard-back" bindtap="backToDirection">返回修改方向</button></block>
 <block wx:if="{{stage==='result'||stage==='text-result'||stage==='image-result'}}"><view class="workflow-step">3/3·成片发布</view><view class="section">成品</view><view class="card"><view class="strong">内容</view><video wx:if="{{publicationKind==='video'}}" class="result-video" src="{{videoUrl}}" controls show-center-play-btn binderror="playbackError"/><image wx:elif="{{publicationKind==='image'}}" class="result-image" src="{{imageResult.url}}" mode="widthFix"/><text wx:else class="text-work-content" selectable>{{textResult.text}}</text><button wx:if="{{publicationKind==='video'}}" class="secondary" bindtap="save" loading="{{saving}}" disabled="{{saving}}">保存视频</button><button wx:elif="{{publicationKind==='image'}}" class="secondary" bindtap="saveImage" loading="{{saving}}">保存图片</button><button wx:else class="secondary" bindtap="copyText">复制正文</button></view><view class="card"><view class="strong">标题</view><input class="publication-title-input" value="{{publicationTitle}}" bindinput="publicationTitle" maxlength="80" placeholder="填写作品标题"/></view><view class="card"><view class="strong">封面</view><image wx:if="{{publicationCover}}" class="publication-cover" src="{{publicationCover}}" mode="aspectFit"/><view wx:else class="publication-cover-empty">选择一张作品封面</view><view class="row actions"><button class="secondary" bindtap="choosePublicationCover">选择封面</button><button wx:if="{{publicationCover}}" class="secondary" bindtap="savePublicationCover">保存封面</button></view></view><view class="section publication-heading"><text>发布作品</text><button class="save-only" bindtap="saveOnly">仅保存</button></view><view class="card"><view class="chips"><text wx:for="{{publicationPlatforms}}" wx:key="id" class="chip {{item.selected?'active':''}}" data-id="{{item.id}}" bindtap="publicationPlatform">{{item.name}}</text></view><block wx:for="{{publicationPlatforms}}" wx:key="id"><button wx:if="{{item.selected}}" class="publication-platform-button" data-id="{{item.id}}" bindtap="preparePlatform">准备在{{item.name}}发布</button></block><view wx:if="{{publishNotice}}" class="publication-notice">{{publishNotice}}</view></view></block>
 <view wx:if="{{stage==='image-generating'}}" class="card"><view class="heading">{{imageJob.status==='failed'?'图片未生成':'图片正在创作中'}} </view><view class="sub">{{imageJob.error||'任务已保存，可以稍后从创作资产继续查看。'}} </view><button class="secondary" bindtap="retryImage">刷新图片状态</button><button wx:if="{{imageJob.status==='failed'}}" class="primary" bindtap="newImageAttempt">重新生成图片</button><button class="secondary" bindtap="edit">返回创作</button></view>
 <view wx:if="{{stage==='generating'}}" class="card generating"><view class="workflow-step">2/3·创造成片 · 生成成片</view><view class="generation-head"><view class="generation-spinner"></view><view><view class="heading">{{generationTitle}}</view><view class="muted">{{generationElapsed}}</view></view></view><view class="generation-track"><view class="generation-line"></view><view class="generation-node active"><text>1</text><view class="generation-label">提交任务</view></view><view class="generation-node {{generationStep>=2?'active':''}}"><text>2</text><view class="generation-label">生成画面</view></view><view class="generation-node {{generationStep>=3?'active':''}}"><text>3</text><view class="generation-label">准备成片</view></view></view><view class="generation-message">{{generationDetail}}</view><view class="muted generation-hint">AI 视频生成可能需要几分钟，页面每 2 秒查询一次进度。{{generationProvider}}</view></view>
 <block wx:if="{{stage==='result'}}"><button class="secondary" bindtap="adjustDirection">调整方向再生成</button><button class="storyboard-back" bindtap="toggleAssets">{{showAssets?'收起本次资产':'查看本次资产'}}</button><view wx:if="{{showAssets&&assetManifest}}" class="asset-manifest"><view class="strong">这条视频保存了什么</view>
 <view class="asset-row" data-section="source" bindtap="toggleAssetSection"><text>参考原片</text><text>{{assetManifest.source.available?'已去重保存':'本次无原片'}} {{assetSection==='source'?'⌃':'›'}}</text></view><view wx:if="{{assetSection==='source'}}" class="asset-detail"><video wx:if="{{assetManifest.source.previewUrl}}" class="asset-source-video" src="{{assetManifest.source.previewUrl}}" controls/><text wx:else>本次从点子或模板开始，没有参考原片。</text></view>
 <view class="asset-row" data-section="analysis" bindtap="toggleAssetSection"><text>内容分析与代表帧</text><text>{{assetManifest.analysis.available?'已保存 · '+assetManifest.analysis.keyframeCount+' 帧':'无'}} {{assetSection==='analysis'?'⌃':'›'}}</text></view><view wx:if="{{assetSection==='analysis'}}" class="asset-detail"><view wx:if="{{assetManifest.analysis.summary}}">{{assetManifest.analysis.summary.orientation}} · {{assetManifest.analysis.summary.pace}}节奏 · {{assetManifest.analysis.summary.durationSeconds}} 秒</view><scroll-view wx:if="{{assetManifest.analysis.previewFrames.length}}" scroll-x class="asset-frames"><image wx:for="{{assetManifest.analysis.previewFrames}}" wx:key="*this" src="{{item}}" mode="aspectFill"/></scroll-view><text wx:else>本次没有代表帧。</text></view>
 <view class="asset-row" data-section="storyboard" bindtap="toggleAssetSection"><text>沟通答案与故事板</text><text>版本 {{assetManifest.storyboard.version}} · {{assetManifest.storyboard.shots.length}} 段 {{assetSection==='storyboard'?'⌃':'›'}}</text></view><view wx:if="{{assetSection==='storyboard'}}" class="asset-detail"><view class="asset-communication">目标：{{assetManifest.communication.goal}} · 受众：{{assetManifest.communication.audience}} · 语气：{{assetManifest.communication.tone}}</view><view class="asset-shot" wx:for="{{assetManifest.storyboard.shots}}" wx:key="role"><text>{{item.role}} {{item.start}}–{{item.end}}s</text><view>{{item.narration}}</view><view class="muted">画面：{{item.visual}}</view></view></view>
 <view class="asset-row" data-section="generation" bindtap="toggleAssetSection"><text>生成请求与实际提示词</text><text>已脱敏保存 {{assetSection==='generation'?'⌃':'›'}}</text></view><view wx:if="{{assetSection==='generation'}}" class="asset-detail"><view>Provider：{{assetManifest.generation.provider}} · {{assetManifest.generation.model}}</view><view wx:if="{{assetManifest.generation.provider==='qianwen'&&assetManifest.generation.settings.resolution}}">{{assetManifest.generation.settings.resolution}} · {{assetManifest.generation.settings.ratio==='adaptive'?'自动画幅':assetManifest.generation.settings.ratio}} · {{assetManifest.generation.settings.duration===-1?'智能时长':assetManifest.generation.settings.duration+' 秒'}} · {{assetManifest.generation.settings.audio?'有声':'静音'}}</view><view class="asset-prompt">{{assetManifest.generation.prompt}}</view></view>
 <view class="asset-row" data-section="lineage" bindtap="toggleAssetSection"><text>最终成片与血缘</text><text>{{assetManifest.database.status==='saved'?'本地与数据库已保存':'本地已保存，数据库待同步'}} {{assetSection==='lineage'?'⌃':'›'}}</text></view><view wx:if="{{assetSection==='lineage'}}" class="asset-detail"><view>运行 ID：{{assetManifest.runId}}</view><view>成片：{{assetManifest.final.sizeBytes}} 字节</view><view>来源哈希：{{assetManifest.lineage.sourceSha256||'无参考原片'}}</view><view>故事板版本：{{assetManifest.lineage.storyboardVersion}}</view></view>
 <view class="muted asset-limit">{{assetManifest.limitations[0]}}</view></view><view class="link" bindtap="permissions">相册权限设置</view><view class="muted">成片和资产包已长期保存；最近记录可重新打开。</view></block>
 <view wx:if="{{showAssets}}" class="card"><view class="strong">飞书同步与归档</view><view>{{archiveLabel||'点击刷新查看状态'}}</view><view class="muted">{{archiveState.error}}</view><view class="link" bindtap="refreshArchive">刷新状态</view><view wx:if="{{!archiveState||archiveState.status==='failed'||archiveState.status==='not_queued'}}" class="link" bindtap="retryArchive">同步并归档</view><view wx:if="{{archiveState.status==='archived'}}" class="link" bindtap="restoreArchive">取回并校验归档</view></view>
 <view wx:if="{{showAssets}}" class="card"><view class="strong">这次创作是否符合预期？</view><view class="chips"><text class="chip" data-rating="满意" bindtap="assetFeedback">满意</text><text class="chip" data-rating="需要修改" bindtap="assetFeedback">需要修改</text></view></view>
 <view wx:if="{{error}}" class="card error-message">{{error}}</view>
</view>
<view wx:if="{{linkNotice}}" class="link-notice-mask" catchtouchmove="noop"><view class="link-notice"><view class="link-notice-title">使用说明</view><view class="link-notice-text">{{linkNoticeText}}</view><view class="link-notice-text link-notice-recognition">{{linkNoticeRecognition}}</view><checkbox-group bindchange="linkNoticeSnooze"><label class="link-notice-snooze"><checkbox value="1" checked="{{linkNoticeSnooze}}"/>1 小时内不再提示</label></checkbox-group><view class="link-notice-actions"><button class="link-notice-btn" bindtap="linkNoticeUpload">上传原视频</button><button class="link-notice-btn" bindtap="linkNoticeAbort">放弃查看</button><button class="link-notice-btn primary" bindtap="linkNoticeAccept">我知道了，开始识别</button></view></view></view>
