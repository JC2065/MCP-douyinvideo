/* 开始解析按钮：胶囊流光进度（渐变流动 + 玻璃高光 + 扫光），总进度 0→100% */
.parse-btn{position:relative;overflow:hidden}
.parse-btn.busy[disabled]{background:linear-gradient(180deg,#b7cdee,#a9c3ea)!important;opacity:1;box-shadow:inset 0 2rpx 4rpx rgba(0,40,100,.12)}
.parse-fill{position:absolute;left:0;top:0;bottom:0;border-radius:38rpx;overflow:hidden;background:linear-gradient(90deg,#1d5fd8,#0a4fc4 30%,#4b63f2 55%,#1f7ef0 80%,#1d5fd8);background-size:200% 100%;animation:parse-flow 3s linear infinite;box-shadow:inset 0 2rpx 0 rgba(255,255,255,.35),0 0 20rpx rgba(40,110,240,.35);transition:width .9s ease-out}
.parse-fill::before{content:'';position:absolute;left:0;right:0;top:0;height:50%;background:linear-gradient(180deg,rgba(255,255,255,.28),rgba(255,255,255,0))}
.parse-fill::after{content:'';position:absolute;top:0;bottom:0;width:45%;left:-45%;background:linear-gradient(100deg,rgba(255,255,255,0),rgba(255,255,255,.38),rgba(255,255,255,0));animation:parse-sheen 2s ease-in-out infinite}
.parse-fill.full::after{animation-iteration-count:1}
.parse-label{position:relative;z-index:1;text-shadow:0 1rpx 2rpx rgba(0,40,100,.35)}
@keyframes parse-flow{to{background-position:-200% 0}}
@keyframes parse-sheen{to{left:110%}}
.parse-btn.soft[disabled]{background:#e3edff!important;color:#0868df!important;opacity:1;font-weight:500}
.deep-progress{margin:18rpx 0 6rpx}.deep-head{display:flex;justify-content:space-between;align-items:baseline}.deep-label{font-size:24rpx;color:#24456f;font-weight:600}.deep-pct{font-size:22rpx;font-weight:700;color:#075dcc}.deep-progress .eta-bar{margin:10rpx 0 0;height:20rpx}
