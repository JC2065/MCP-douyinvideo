.quota-actions{display:flex;gap:16rpx;margin:12rpx 0 0}.quota-actions button{flex:1;margin:0!important;width:auto!important;height:68rpx;line-height:68rpx;padding:0!important;font-size:24rpx;border-radius:34rpx}.quota-buy{background:#fff!important;color:#9a5b00!important;border:1rpx solid #f0c46c}.quota-apply{background:#fff3d6!important;color:#9a5b00!important}.quota-ok{font-size:24rpx;color:#15803d;margin-top:10rpx}.quota-sheet{width:100%;box-sizing:border-box;background:#fff;border-radius:28rpx 28rpx 0 0;padding:28rpx 28rpx 48rpx}.quota-sheet-head{display:flex;justify-content:space-between;align-items:center;margin-bottom:8rpx}
