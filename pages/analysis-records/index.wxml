<app-navigation title="我的拆解记录"/><view class="shell"><view class="heading">我的拆解记录</view><view class="muted">后台拆解完成后自动收录；本机保留最近30条记录，任务完成结果保存在服务器。</view><view wx:if="{{error}}" class="empty">{{error}}</view><button bindtap="refresh">刷新任务</button><view class="card" wx:for="{{queued}}" wx:key="jobId" data-id="{{item.jobId}}" bindtap="openQueued"><view class="strong">{{item.status==='failed'?'拆解失败':item.status==='done'?'后台拆解完成':'后台拆解中'}}</view><view class="muted">{{item.status==='done'?'点开继续拆解':item.error||'完成后自动存入拆解记录，点开查看进度'}}</view></view><view wx:if="{{!rows.length&&!queued.length}}" class="empty">完成拆解后保存，或选择后台排队。</view><view class="card" wx:for="{{rows}}" wx:key="id" data-id="{{item.id}}" bindtap="open"><view class="strong">{{item.title}}</view><view class="muted">{{item.reference.asset.media.durationSeconds||'—'}} 秒 · {{item.sampling}}</view><view class="link">查看拆解</view></view><view class="card" wx:if="{{selected}}"><view class="strong">{{selected.title}}</view><view class="body" wx:for="{{selected.reference.analysis.reusableStrategies}}" wx:key="*this">{{item}}</view><view class="muted">原始分享内容：{{selected.sourceValue}}</view><button bindtap="close">收起</button></view></view>
