<app-navigation title="拆解工作台"/>
<view class="shell analysis-studio">
 <view class="studio-panel sync-panel"><text class="strong">{{saveState}}</text><button class="secondary" bindtap="syncAgain">重新同步</button><view wx:if="{{syncConflict}}"><button class="secondary" data-choice="cloud" bindtap="syncResolve">使用云端版本</button><button class="secondary" data-choice="local" bindtap="syncResolve">保留本机并上传</button></view><button wx:if="{{hasSyncBackup}}" class="secondary" bindtap="syncRestore">恢复本机备份</button></view>
 <block wx:if="{{!syncBusy}}">
 <view class="section">默认拆解模板</view><view class="default-template-grid"><view class="default-template {{preview.preset.id===item.id?'is-selected':''}}" wx:for="{{presets}}" wx:key="id" data-id="{{item.id}}" bindtap="defaultTemplate"><view class="strong">{{item.name}}</view><text>{{item.description}}</text></view></view><view class="heading">按你的目标看懂素材</view><view class="sub">先选素材类型，再组合目标。模板可以直接用，也可以改成自己的方法。</view>
 <view class="studio-panel"><view class="section">素材类型</view><picker range="{{types}}" range-key="name" value="{{materialIndex}}" bindchange="material"><view class="studio-select">{{types[materialIndex].name}}<text>更换 ▾</text></view></picker><view class="chips"><text class="chip {{prefs.mode==='auto'?'active':''}}" data-mode="auto" bindtap="mode">按素材匹配</text><text class="chip {{prefs.mode==='manual'?'active':''}}" data-mode="manual" bindtap="mode">统一指定模板</text></view><view class="section">拆解目标 <text class="muted">可多选</text></view><view class="chips"><text wx:for="{{goals}}" wx:key="id" class="chip {{item.picked?'active':''}}" data-id="{{item.id}}" bindtap="goal">{{item.name}}</text></view></view>
 <view class="studio-panel"><view class="section">当前模板</view><picker range="{{templates}}" range-key="name" value="{{templateIndex}}" bindchange="chooseTemplate"><view class="studio-select">{{preview.preset.name}}<text>选择 ▾</text></view></picker><text class="muted">{{preview.preset.description}}</text><view class="preview-row" wx:for="{{preview.sections}}" wx:key="key"><view class="strong">{{index+1}}. {{item.title}}</view><text class="muted">{{item.question}}</text></view><button class="primary" bindtap="useForType">设为{{types[materialIndex].name}}默认模板</button><button class="secondary" bindtap="diy">复制并 DIY</button><button wx:if="{{prefs.mode==='manual'}}" class="secondary" bindtap="select">所有素材统一使用当前模板</button><text class="studio-note">默认类型从素材信息推断，具体案例可独立修改。{{saveState}}。</text></view>
 <view class="studio-panel" wx:if="{{editor}}"><view class="section">编辑我的模板</view><input class="input" value="{{editor.name}}" maxlength="32" placeholder="模板名称" data-field="name" bindinput="field"/><textarea class="template-description" value="{{editor.description}}" maxlength="160" placeholder="这个模板帮你解决什么问题？" data-field="description" bindinput="field"/><view class="editor-section" wx:for="{{editor.sections}}" wx:key="key"><input class="input" value="{{item.title}}" maxlength="40" placeholder="栏目标题" data-index="{{index}}" data-field="title" bindinput="sectionField"/><textarea value="{{item.question}}" maxlength="240" placeholder="你希望从素材中观察或学习什么？" data-index="{{index}}" data-field="question" bindinput="sectionField"/><view class="editor-actions"><button disabled="{{index===0}}" data-index="{{index}}" data-direction="-1" bindtap="move">上移</button><button disabled="{{index===editor.sections.length-1}}" data-index="{{index}}" data-direction="1" bindtap="move">下移</button><button data-index="{{index}}" bindtap="removeSection">删除栏目</button></view></view><button class="secondary" bindtap="addSection">添加自定义栏目</button><view class="section">跟着练习</view><textarea class="practice-editor" value="{{stepsText}}" maxlength="2800" placeholder="每行一个练习步骤，可自由改写" bindinput="stepInput"/><view wx:if="{{error}}" class="studio-error">{{error}}</view><button class="primary" bindtap="saveTemplate">保存我的模板</button><button class="secondary" bindtap="saveAsNew">另存为新模板</button><button class="secondary" bindtap="cancelEdit">放弃编辑</button></view>
 <view wx:if="{{error&&!editor}}" class="studio-error">{{error}}</view><view class="section">我的模板 <text class="muted">{{customTemplates.length||0}} / 20</text></view><view class="studio-empty" wx:if="{{!customTemplates.length}}">从当前模板点“复制并 DIY”，保存你常用的拆解方法。</view><view class="library-row" wx:for="{{customTemplates}}" wx:key="id"><view class="strong">{{item.name}}</view><text class="muted">{{item.sections.length}}个栏目 · 版本{{item.version}}</text><view class="editor-actions"><button data-id="{{item.id}}" bindtap="edit">编辑</button><button data-id="{{item.id}}" bindtap="select">使用此模板</button><button data-id="{{item.id}}" bindtap="removeTemplate">删除</button></view></view>
 <text class="studio-note">自定义问题决定拆解重点；没有画面或音轨依据时保留“未观察到”，不会把模板要求当作事实。</text><button class="secondary" bindtap="clearOverrides">恢复案例跟随默认设置</button>
 </block>
</view>
