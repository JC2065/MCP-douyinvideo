.analysis-studio{padding-top:24rpx}.analysis-studio .heading{color:#20314a;font-size:40rpx}.analysis-studio .sub{color:#65748a}.studio-panel{background:#fff;padding:26rpx;margin:24rpx 0;border-top:5rpx solid #c7d8ed;border-radius:12rpx}.section{margin:22rpx 0 18rpx}.chips{display:flex;flex-wrap:wrap;gap:14rpx;margin:24rpx 0}.chip{border:2rpx solid #d9e3ef;border-radius:30rpx;padding:14rpx 24rpx;color:#65748a;font-size:26rpx}.chip.active{background:#e9f2ff;color:#0868df;border-color:#0868df}.studio-select{display:flex;justify-content:space-between;gap:20rpx;padding:22rpx 0;color:#20314a;border-bottom:2rpx solid #d9e3ef;font-weight:650}.studio-select text{color:#0868df;font-size:25rpx}.preview-row{padding:20rpx 0;border-bottom:2rpx solid #edf1f6}.studio-note{display:block;color:#65748a;font-size:24rpx;line-height:1.7;margin:24rpx 0}.primary{background:#0868df}.secondary{background:#e9f2ff;color:#0868df;margin-top:18rpx}.editor-section{border-left:5rpx solid #c7d8ed;padding-left:20rpx;margin-top:30rpx}.editor-section textarea,.template-description,.practice-editor{height:160rpx;width:100%;background:#f5f8fc;border-radius:12rpx;padding:22rpx;line-height:1.7;font-size:26rpx}.practice-editor{height:240rpx}.editor-actions{display:flex;gap:12rpx;margin-top:14rpx}.editor-actions button{flex:1;background:transparent;color:#0868df;font-size:24rpx;padding:0 8rpx;line-height:2.8}.studio-error{background:#fff0ef;color:#9d3030;padding:20rpx;margin:20rpx 0}.studio-empty{padding:26rpx 0;color:#65748a;line-height:1.7}.library-row{padding:24rpx 0;border-bottom:2rpx solid #d9e3ef}

.default-template-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:16rpx;margin:20rpx 0 36rpx}.default-template{background:#fff;padding:24rpx;border-radius:20rpx;border:1rpx solid #dce8f8}.default-template text{display:block;font-size:23rpx;line-height:1.6;color:#7b8ba4;margin-top:10rpx}

.default-template.is-selected{border-color:#1671eb;background:#edf5ff;box-shadow:inset 0 0 0 1rpx #1671eb}
