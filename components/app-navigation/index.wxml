<view style="height:{{top+height}}px"></view>
<view class="navigation" style="padding-top:{{top}}px">
 <view class="navigation-row" style="height:{{height}}px;padding-right:{{right}}px">
  <button wx:if="{{!root||internal}}" class="back-button" hover-class="back-pressed" hover-stay-time="80" bindtap="back" aria-label="返回上一页"><image src="/assets/icons/back-selected.png" mode="aspectFit"/><text>返回</text></button>
  <view wx:if="{{prefixes.length}}" class="navigation-title rot-title" style="max-width:calc(100% - {{(right>104?right:104)*2}}px)"><view class="rot-box"><text class="rot-prefix rot-{{rotFlip||'a'}}">{{prefix}}</text></view><text class="rot-suffix">{{title}}</text></view><text wx:else class="navigation-title" style="max-width:calc(100% - {{(right>104?right:104)*2}}px)">{{title}}</text>
 </view>
</view>
<movable-area wx:if="{{!root||internal||active}}" class="float-zone" style="top:{{top+height}}px;width:{{winW}}px;height:{{areaH}}px">
 <movable-view class="float-ball" direction="all" damping="50" x="{{ballX}}" y="{{ballY}}" bindchange="onMove" bindtouchstart="onDown" bindtouchend="onUp" bindtouchcancel="onUp">
  <view wx:if="{{!root||internal}}" class="ball-inner {{pressed?'ball-pressed':''}}" bindtap="back" bindlongpress="openSheet" aria-label="返回上一页（悬浮按钮，可拖拽）" role="button"><image src="/assets/icons/back-selected.png" mode="aspectFit"/></view>
  <view wx:else class="ball-inner ball-tasks {{pressed?'ball-pressed':''}}" bindtap="openSheet" bindlongpress="openSheet" aria-label="后台任务 {{tasks.length}} 条" role="button"><text>任务</text></view>
  <view wx:if="{{active}}" class="ball-badge {{ready?'ready':''}}"><view wx:if="{{running&&!ready}}" class="queue-spin"></view><text wx:else>{{ready?'✓'+ready:running}}</text></view>
  <view wx:if="{{hint}}" class="ball-hint {{ballX>winW/2?'on-left':''}}">长按查看后台任务</view>
 </movable-view>
</movable-area>
<view wx:if="{{sheet}}" class="task-mask" bindtap="closeSheet" catchtouchmove="closeSheet"></view>
<view wx:if="{{sheet}}" class="task-sheet">
 <view class="task-grip"></view>
 <view class="task-head"><view><view class="task-title">后台任务</view><view class="task-sub">{{running?running+' 条拆解中':''}}{{running&&ready?' · ':''}}{{ready?ready+' 条待查看':''}}{{!running&&!ready?'都已查看':''}}</view></view><text class="task-link" bindtap="allRecords">全部拆解记录 ›</text></view>
 <view wx:for="{{tasks}}" wx:key="jobId" class="task-row {{item.seen?'seen':''}}" data-id="{{item.jobId}}" bindtap="markSeen">
  <view class="task-dot {{item.status}}"><view wx:if="{{item.status==='running'}}" class="queue-spin"></view><text wx:elif="{{item.status==='done'}}">✓</text><text wx:else>!</text></view>
  <view class="task-main"><view class="task-name">{{item.title}}</view><view class="task-meta"><text wx:if="{{!item.live}}" class="task-remove" data-id="{{item.jobId}}" catchtap="removeTask">移除</text><text class="task-state {{item.status}}">{{item.live?'当前任务 · '+item.stage:item.seen?(item.status==='done'?'已查看 · 拆解完成':'已查看 · '+(item.error||'拆解失败')):item.status==='done'?'拆解完成，点一下标为已查看':item.status==='failed'?(item.error||'拆解失败'):'拆解中 · 已等 '+item.waited+' 分钟'}}</text></view></view>
  <view class="task-side"><text class="task-go" data-id="{{item.jobId}}" catchtap="openTask">{{item.status==='done'?'继续':item.status==='failed'?'重新提交':'查看'}}</text></view>
 </view>
 <button class="task-close" bindtap="closeSheet">收起</button>
</view>
