.study{padding:32rpx 30rpx 70rpx}.study-label{font-size:22rpx;color:#58846d;display:flex;justify-content:space-between;margin-bottom:24rpx}.study-label text{color:#8a968f}.player{width:100%;height:690rpx;background:#101813;border-radius:24rpx;overflow:hidden}.caption{font-size:21rpx;color:#8a968f;margin:16rpx 0 28rpx}.study-tabs{display:flex;position:sticky;top:0;z-index:3;background:#f7f8fa;padding:16rpx 0;gap:8rpx;border-bottom:1rpx solid #e0e8e2}.study-tabs view{flex:1;text-align:center;padding:18rpx 8rpx;font-size:26rpx;border-radius:14rpx;color:#829188}.study-tabs .chosen{background:#2c755c;color:white}.takeaway{background:#eaf3ed}.lesson{font-size:36rpx;font-weight:650;line-height:1.6;margin-top:20rpx}.evidence{padding:26rpx;font-size:24rpx;color:#819087;line-height:1.8}.frame{display:block;width:100%;height:400rpx;background:#132017;border-radius:16rpx;margin:24rpx 0}.segment.playing{border-color:#45876a}.neutral{background:#f1f0ea;color:#8a7b59}.learn{background:#f1f6f2;padding:22rpx;border-radius:16rpx}.learn .body{margin-bottom:0}.check{padding:24rpx 10rpx;border-bottom:1rpx solid #e2e9e4;line-height:1.7}.check text{color:#28765c;font-size:32rpx;margin-right:12rpx}.practice-script{white-space:pre-wrap}

.loading-player{display:flex;align-items:center;justify-content:center;color:#c7d8cd;font-size:26rpx}

.analysis-box{background:#edf4ee;border:1rpx solid #dbe9df;border-radius:24rpx;padding:26rpx;margin:22rpx 0}.analysis-box .body{font-size:25rpx}.selector{padding:22rpx;background:white;border-radius:14rpx;font-size:24rpx;display:flex;justify-content:space-between}.analysis-box .link{margin:0}

.analysis-goals{display:flex;flex-wrap:wrap;gap:12rpx;margin:18rpx 0}.analysis-goal{padding:12rpx 20rpx;border:2rpx solid #d9e3ef;border-radius:28rpx;color:#65748a;font-size:24rpx}.analysis-goal.picked{background:#e9f2ff;border-color:#0868df;color:#0868df}
