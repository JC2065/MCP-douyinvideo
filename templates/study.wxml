<view class="study">
 <view class="study-label">精选案例 / {{item.id}} <text>{{item.tag}} · {{item.duration}} 秒</text></view>
 <view class="heading">{{item.title}}</view><view class="sub">{{item.method}}</view>
 <view wx:if="{{loading}}" class="player loading-player">正在准备本地视频…</view>
 <video wx:if="{{videoSrc}}" id="caseVideo" class="player" src="{{videoSrc}}" controls object-fit="contain" autoplay="{{false}}" bindtimeupdate="time" binderror="failed"/>
 <view wx:if="{{error}}" class="card">视频暂时无法播放。<view class="body">{{errorMessage}}</view><button class="secondary" bindtap="retry">重新加载视频</button></view>
 <view class="caption">用户提供原片 · 本地低码率预览 · 点击播放完整观看</view>
 <view wx:if="{{templateSyncState}}" class="caption">{{templateSyncState}} <text class="link" bindtap="settings">同步设置 ›</text></view>
 <view class="analysis-box" wx:if="{{analysis}}"><view class="row"><text class="strong">{{analysis.mode==='auto'?'自动匹配':'手动指定'}} · {{analysis.preset.name}}</text><text class="link" bindtap="settings">设置 ›</text></view><view class="body">{{analysis.reason}}</view><view wx:if="{{analysis.supplements.length}}" class="muted">补充维度：{{analysis.supplementLabel}}</view><picker range="{{analysisOptions}}" value="{{analysisIndex}}" bindchange="chooseAnalysis"><view class="selector">本案例方案：{{analysisOptions[analysisIndex]}} <text>切换 ▾</text></view></picker><view class="caption">{{analysis.engine}}</view></view>
 <view class="study-tabs"><view wx:for="{{sections}}" wx:key="*this" data-name="{{item}}" bindtap="section" class="{{section===item?'chosen':''}}">{{item}}</view></view>
 <view class="analysis-box"><picker range="{{materialOptions}}" range-key="name" value="{{materialIndex}}" bindchange="analysisMaterial"><view class="selector">素材：{{analysis.materialLabel}} · 更换 ▾</view></picker><view class="caption">本案例目标，可多选</view><view class="analysis-goals"><text wx:for="{{analysisGoals}}" wx:key="id" class="analysis-goal {{item.picked?'picked':''}}" data-id="{{item.id}}" bindtap="analysisGoal">{{item.name}}</text></view></view>
 <block wx:if="{{section==='看懂作品'}}">
  <view class="card takeaway"><text class="badge">{{analysis.preset.name}} · 学习重点</text><view class="lesson">{{analysis.preset.description}}</view><view class="body">{{item.structure}}</view></view>
  <view class="card" wx:for="{{analysis.sections}}" wx:key="key"><view class="strong">{{index+1}} {{item.title}}</view><view wx:if="{{item.question}}" class="caption">{{item.question}}</view><text wx:if="{{item.status==='未观察到'}}" class="badge neutral">未观察到</text><view class="body">{{item.text}}</view></view>
  <view class="card" wx:if="{{analysis.supplements.length}}"><view class="row supplement-toggle" bindtap="toggleSupplements"><text class="strong">补充观察 · {{analysis.supplements.length}} 个维度</text><text class="link">{{supplementsOpen?'收起 −':'展开 ＋'}}</text></view><view wx:if="{{supplementsOpen}}" wx:for="{{analysis.supplements}}" wx:key="key"><view class="section">{{item.title}}</view><view class="body">{{item.text}}</view></view></view>
  <view class="card"><view class="row base-toggle" bindtap="toggleDetails"><text class="strong">基础信息与观察依据</text><text class="link">{{detailsOpen?'收起 −':'展开 ＋'}}</text></view><view wx:if="{{detailsOpen}}"><view class="body">来源：{{analysis.base.source}}
时长：{{analysis.base.duration}} 秒
观察范围：{{analysis.base.observation}}</view><view class="body" wx:for="{{analysis.base.facts}}" wx:key="time">{{item.time}} · {{item.text}}</view><view class="body">待核实：{{analysis.base.unknown}}</view><text class="muted">框架版本：{{analysis.version}}</text></view></view>
  <view class="evidence"><view class="strong">观察范围与效果边界</view><view class="body">{{item.pitfall}}</view><view class="body">时间段为教学观察窗口，不等同于精确镜头切点。没有后台传播数据，不标注爆款成绩。</view><view class="link" bindtap="source">方法参考：TikTok Creative Codes ↗</view><text class="muted">点击复制来源链接。不同预设只改变分析重点，不改变原片事实。</text></view>
 </block>
 <block wx:if="{{section==='逐段拆解'}}"><view class="sub">{{analysis.segmentation.label}} · {{analysis.segmentation.note}} 点击时间段回看片段。</view><view class="card segment {{active===index?'playing':''}}" wx:for="{{item.segments}}" wx:key="start"><view class="row"><text class="strong">{{index+1}} / {{item.name}}</text><button class="small secondary" data-index="{{index}}" bindtap="seek">▶ {{item.label}}</button></view><image class="frame" src="{{item.image}}" mode="aspectFit" data-index="{{index}}" bindtap="seek"/><text class="badge">画面事实</text><view class="body">{{item.fact}}</view><text class="badge neutral">拆解观点</text><view class="body">{{item.analysis}}</view><view class="learn"><text class="strong">换成你的作品</text><view class="body">{{item.learn}}</view></view></view></block>
 <block wx:if="{{section==='跟着练习'}}"><view class="section">用{{analysis.preset.name}}练一条</view><view class="sub">先换成自己的主题，保留表达方法。</view><view class="card"><view class="strong">当前方案的练习步骤</view><view class="body practice-script">{{analysis.practice}}</view></view><view class="card"><view class="strong">结合本案例</view><view class="body practice-script">{{item.script}}</view></view><view class="section">开拍前，准备三件事</view><view class="check" wx:for="{{['一个明确的受众和主题','与描述相符的真实画面','可核实信息与清楚的表达边界']}}" wx:key="*this" data-index="{{index}}" bindtap="check"><text>{{checks[index]?'✓':'○'}}</text> {{item}}</view><input class="input" placeholder="你的主题，例如：手作陶瓷杯" value="{{theme}}" bindinput="theme" maxlength="100"/><button class="primary" bindtap="create">用此方案，开始我的创作</button><view class="sub">主题、案例来源与所选方案一起带入草稿。</view></block>
 <view class="actions row"><button class="secondary" bindtap="favorite">{{favorited?'已收藏 · 点击取消':'收藏案例'}}</button><button class="secondary" bindtap="note">记下这条灵感</button></view>
</view>
