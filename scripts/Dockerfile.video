FROM python:3.12.8-slim-bookworm
WORKDIR /app
RUN pip install --no-cache-dir pillow==11.3.0 imageio-ffmpeg==0.6.0 faster-whisper==1.1.0
RUN pip install --no-cache-dir requests==2.32.3 av==17.0.0
RUN pip install --no-cache-dir jieba==0.42.1
RUN python -c "from huggingface_hub import snapshot_download; [snapshot_download('Systran/faster-whisper-'+m, local_dir='/opt/whisper/'+m, allow_patterns=['config.json','model.bin','tokenizer.json','vocabulary.*']) for m in ('tiny','base','small')]"
# Local on-screen text OCR (CPU). Headless OpenCV avoids GUI libraries in the slim image; rapidocr is installed without its opencv-python dependency.
RUN pip install --no-cache-dir onnxruntime==1.20.1 opencv-python-headless==4.10.0.84 pyclipper==1.3.0.post6 shapely==2.0.6 PyYAML==6.0.2 six==1.16.0 && pip install --no-cache-dir --no-deps rapidocr-onnxruntime==1.4.4
# Chinese font (Noto Sans CJK = Source Han Sans, SIL OFL) for composed text videos and rendered samples.
RUN apt-get update && apt-get install -y --no-install-recommends fonts-noto-cjk && rm -rf /var/lib/apt/lists/*
COPY scripts/hotspot-content.py scripts/hotspot-feed.py scripts/client-config.py scripts/video-server.py scripts/asset-archive.py scripts/asset-ledger.py scripts/wechat-auth.py scripts/verify-feishu-archive.py ./scripts/
COPY scripts/admin-console.py scripts/admin-console.html scripts/analysis-plan.py scripts/analysis-preferences.py scripts/mcp-gateway.py ./scripts/
COPY utils/platform-boundaries.json ./utils/
COPY scripts/content-boundaries.py scripts/hotspot-summary.py scripts/hotspot-watch.py scripts/inspiration-ai.py scripts/text-works.py scripts/topic-chat.py scripts/platform-config.py scripts/user-profile.py scripts/watch-flow.py scripts/usage-ledger.py scripts/content-understanding.py scripts/image-works.py scripts/replica.py scripts/link-platform.py scripts/top-comments.py scripts/screen-text.py scripts/creation-board.py scripts/idea-box.py ./scripts/
ENV YOUAI_VIDEO_FONT=/usr/share/fonts/opentype/noto/NotoSansCJK-Regular.ttc PYTHONUNBUFFERED=1 YOUAI_VIDEO_HOST=0.0.0.0 YOUAI_VIDEO_PORT=8765
CMD ["python", "scripts/video-server.py"]
